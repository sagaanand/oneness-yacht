<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sign In — Oneness Yachts</title>
  <link rel="icon" type="image/svg+xml" href="/assets/images/icon.svg">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="/assets/css/luxury.css">
  <style>
    body { background: var(--navy-950); min-height: 100vh; display: flex; align-items: center; justify-content: center; }
    .auth-page { width: 100%; max-width: 480px; margin: 0 auto; padding: 24px; }
    .auth-card { background: var(--white); border-radius: var(--radius-xl); padding: 48px 40px; box-shadow: var(--shadow-xl); }
    .auth-logo { font-size: 11px; font-weight: 700; letter-spacing: 4px; text-transform: uppercase; color: var(--gold); text-align: center; margin-bottom: 32px; }
  </style>
</head>
<body>
<a href="/" style="position:fixed; top:20px; left:24px; font-size:11px; font-weight:700; letter-spacing:3px; text-transform:uppercase; color:rgba(255,255,255,0.5)">← Back</a>

<div class="auth-page">
  <div class="auth-card">
    <div class="auth-logo">ONENESS YACHTS</div>

    <div class="auth-container" style="max-width:none; padding:0">
      <h1 class="auth-title">Sign In</h1>
      <p class="auth-sub">Continue to manage your charters and bookings.</p>

      <button class="auth-provider-btn" id="googleBtn">
        <svg width="20" height="20" viewBox="0 0 24 24"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/></svg>
        Continue with Google
      </button>

      <button class="auth-provider-btn" id="appleBtn" style="background:var(--navy-900); color:var(--white); border-color:var(--navy-900)">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="white"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98l-.09.06c-.22.14-2.18 1.27-2.16 3.8.02 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.73zM13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/></svg>
        Continue with Apple
      </button>

      <div class="auth-divider">or continue with email</div>

      <!-- Email OTP -->
      <div id="emailSection">
        <div class="form-group">
          <label class="form-label" for="authEmail">Email Address</label>
          <input type="email" class="form-input" id="authEmail" placeholder="you@example.com" autocomplete="email" autofocus>
        </div>
        <div class="form-group">
          <label class="form-label" for="authName">Your Name (first time only)</label>
          <input type="text" class="form-input" id="authName" placeholder="Your full name" autocomplete="name">
        </div>
        <button class="btn btn-dark btn-block" id="sendOtpBtn">
          <i class="fa-solid fa-envelope"></i> Send Code
        </button>
      </div>

      <!-- OTP Entry -->
      <div id="otpSection" style="display:none">
        <p style="text-align:center; font-size:14px; color:var(--text-secondary); margin-bottom:20px">
          We sent a 6-digit code to <strong id="otpTarget"></strong>
        </p>
        <div id="devOtpBanner" style="display:none; background:#fff8e1; border:1px solid #fce082; border-radius:8px; padding:12px; font-size:13px; margin-bottom:16px; text-align:center">
          <i class="fa-solid fa-flask" style="color:#d97706"></i> Dev mode — OTP: <strong id="devOtpVal"></strong>
        </div>
        <div class="otp-fields" id="otpFields" style="display:flex; gap:10px; justify-content:center; margin-bottom:20px">
          <input type="text" class="otp-input" maxlength="1" inputmode="numeric" pattern="[0-9]" aria-label="Code digit 1">
          <input type="text" class="otp-input" maxlength="1" inputmode="numeric" pattern="[0-9]" aria-label="Code digit 2">
          <input type="text" class="otp-input" maxlength="1" inputmode="numeric" pattern="[0-9]" aria-label="Code digit 3">
          <input type="text" class="otp-input" maxlength="1" inputmode="numeric" pattern="[0-9]" aria-label="Code digit 4">
          <input type="text" class="otp-input" maxlength="1" inputmode="numeric" pattern="[0-9]" aria-label="Code digit 5">
          <input type="text" class="otp-input" maxlength="1" inputmode="numeric" pattern="[0-9]" aria-label="Code digit 6">
        </div>
        <button class="btn btn-primary btn-block" id="verifyOtpBtn">
          <i class="fa-solid fa-check"></i> Verify & Sign In
        </button>
        <button class="btn btn-outline-dark btn-block btn-sm" id="resendBtn" style="margin-top:10px">← Change Email</button>
      </div>

      <div id="authError" style="display:none; background:var(--status-cancelled-bg); color:var(--status-cancelled); padding:12px 16px; border-radius:var(--radius-md); font-size:14px; margin-top:16px;"></div>
    </div>
  </div>
</div>

<style>
.otp-input { width:52px; height:60px; text-align:center; font-family:var(--font-serif); font-size:28px; border:2px solid var(--line-dark); border-radius:var(--radius-md); outline:none; transition:border-color 0.2s; }
.otp-input:focus { border-color:var(--navy-600); }
</style>

<script>
const returnTo = new URLSearchParams(window.location.search).get('returnTo') || '/account';
let pendingEmail = '';

// Google
document.getElementById('googleBtn').addEventListener('click', async () => {
  const res = await fetch('/api/v1/auth/oauth-url?provider=GOOGLE&redirectAfter=' + encodeURIComponent(returnTo));
  const data = await res.json();
  if (data.url) window.location.href = data.url;
  else showError('Google Sign In not configured. Please use email OTP.');
});

// Apple
document.getElementById('appleBtn').addEventListener('click', async () => {
  const res = await fetch('/api/v1/auth/oauth-url?provider=APPLE&redirectAfter=' + encodeURIComponent(returnTo));
  const data = await res.json();
  if (data.url) window.location.href = data.url;
  else showError('Apple Sign In not configured. Please use email OTP.');
});

// Send OTP
document.getElementById('sendOtpBtn').addEventListener('click', async () => {
  const email = document.getElementById('authEmail').value.trim();
  if (!email || !email.includes('@')) { showError('Enter a valid email address.'); return; }
  const name = document.getElementById('authName').value.trim();

  document.getElementById('sendOtpBtn').textContent = 'Sending...';
  document.getElementById('sendOtpBtn').disabled = true;

  const res = await fetch('/api/v1/auth/send-otp', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ identifier: email, identifierType: 'EMAIL', name })
  });
  const data = await res.json();

  document.getElementById('sendOtpBtn').textContent = 'Send Code';
  document.getElementById('sendOtpBtn').disabled = false;

  if (data.success) {
    pendingEmail = email;
    document.getElementById('emailSection').style.display = 'none';
    document.getElementById('otpSection').style.display = 'block';
    document.getElementById('otpTarget').textContent = email;
    if (data.devMode && data.otp) {
      document.getElementById('devOtpBanner').style.display = 'block';
      document.getElementById('devOtpVal').textContent = data.otp;
    }
    setupOtpInputs();
    clearError();
  } else {
    showError(data.error || 'Failed to send code. Try again.');
  }
});

// Verify OTP
document.getElementById('verifyOtpBtn').addEventListener('click', async () => {
  const code = Array.from(document.querySelectorAll('#otpFields .otp-input')).map(i => i.value).join('');
  if (code.length < 6) { showError('Enter all 6 digits.'); return; }
  const name = document.getElementById('authName').value.trim();

  document.getElementById('verifyOtpBtn').textContent = 'Verifying...';
  document.getElementById('verifyOtpBtn').disabled = true;

  const res = await fetch('/api/v1/auth/verify-otp', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ identifier: pendingEmail, identifierType: 'EMAIL', code, customerInfo: { name } })
  });
  const data = await res.json();

  document.getElementById('verifyOtpBtn').textContent = 'Verify & Sign In';
  document.getElementById('verifyOtpBtn').disabled = false;

  if (data.success) {
    window.location.href = returnTo;
  } else {
    showError(data.error || 'Invalid code. Try again.');
  }
});

document.getElementById('resendBtn').addEventListener('click', () => {
  document.getElementById('emailSection').style.display = 'block';
  document.getElementById('otpSection').style.display = 'none';
  document.getElementById('devOtpBanner').style.display = 'none';
  clearError();
});

function setupOtpInputs() {
  const inputs = document.querySelectorAll('#otpFields .otp-input');
  inputs.forEach((input, i) => {
    input.value = '';
    input.addEventListener('input', e => { if (e.data && /[0-9]/.test(e.data) && i < inputs.length - 1) inputs[i + 1].focus(); });
    input.addEventListener('keydown', e => { if (e.key === 'Backspace' && !input.value && i > 0) inputs[i - 1].focus(); });
    input.addEventListener('paste', e => {
      const p = e.clipboardData.getData('text').replace(/\D/g,'');
      inputs.forEach((inp, j) => inp.value = p[j] || '');
      e.preventDefault();
    });
  });
  inputs[0].focus();
}

function showError(msg) { const e = document.getElementById('authError'); e.textContent = msg; e.style.display = 'block'; }
function clearError() { document.getElementById('authError').style.display = 'none'; }
</script>
</body>
</html>
