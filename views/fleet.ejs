<%- include('partials/header', { title: 'The Prestige Fleet (Dubai & Miami) | Oneness Luxury Yachts', activeNav: 'fleet' }) %>

<div class="fleet-white-page">
  <!-- FLEET CATALOGUE HERO (WHITE LUXURY THEME) -->
  <section class="fleet-hero-white">
    <div class="container" style="text-align: center;">
      <div class="eyebrow" style="justify-content: center;">Global Prestige Collection</div>
      <h1 class="editorial-title editorial-title-lg" style="margin-bottom: 16px;">
        THE FLEET.
      </h1>
      <p class="editorial-subhead" style="margin: 0 auto;">
        Command the world's most sought-after superyachts across two iconic nautical capitals. Choose your destination to view our hand-curated vessels.
      </p>

      <!-- Interactive Destination Switcher (Dubai & Miami) -->
      <div class="destination-switch-container" role="tablist" aria-label="Charter Destination Switcher">
        <button type="button" class="dest-tab-btn active" id="tabBtnDubai" onclick="switchDestination('dubai')" role="tab" aria-selected="true" aria-controls="dubaiFleetSection">
          <span class="dest-tab-dot"></span>
          <span>Dubai Marina & Palm</span>
          <span style="font-size: 0.68rem; color: #9e825a; margin-left: 4px; font-weight: 700;">(39 Vessels)</span>
        </button>

        <button type="button" class="dest-tab-btn" id="tabBtnMiami" onclick="switchDestination('miami')" role="tab" aria-selected="false" aria-controls="miamiFleetSection">
          <span class="dest-tab-dot"></span>
          <span>Miami Beach & Biscayne</span>
          <span style="font-size: 0.68rem; color: #9e825a; margin-left: 4px; font-weight: 700;">(39 Vessels)</span>
        </button>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       SECTION 1: DUBAI FLEET VIEW
       ========================================================================= -->
  <section id="dubaiFleetSection" class="destination-view active section" style="padding-top: 50px; padding-bottom: 120px;">
    <div class="container">
      
      <!-- Elevative Dubai Destination Hero Banner -->
      <div class="destination-elevative-banner">
        <div class="dest-banner-media" style="background-image: url('/assets/images/home/IMAGE-1.jpg');"></div>
        <div class="dest-banner-gradient"></div>
        
        <div class="dest-banner-content">
          <div>
            <div class="eyebrow" style="color: #dfcaa8; margin-bottom: 8px;">United Arab Emirates &middot; Arabian Gulf</div>
            <h2 class="dest-banner-title">The Dubai Collection</h2>
            <p class="dest-banner-sub">
              Command 39 bespoke motor yachts and superyachts cruising Dubai Marina, the Palm Jumeirah, Burj Al Arab, and the World Islands.
            </p>
          </div>

          <div class="dest-banner-stats">
            <span>39 Vessels</span>
            <span>&bull;</span>
            <span>Dubai Marina Berths</span>
            <span>&bull;</span>
            <span>24/7 Concierge</span>
          </div>
        </div>
      </div>

      <!-- Dubai Filter Controls -->
      <div class="fleet-filter-bar-white">
        <button type="button" class="filter-pill-white active" data-dest="dubai" data-filter="all">All Dubai Vessels (39)</button>
        <button type="button" class="filter-pill-white" data-dest="dubai" data-filter="vip">Superyachts (100ft+)</button>
        <button type="button" class="filter-pill-white" data-dest="dubai" data-filter="standard">Motor Yachts (45–90ft)</button>
        <button type="button" class="filter-pill-white" data-dest="dubai" data-filter="mega">Mega Yachts (130ft+)</button>
      </div>

      <!-- Dubai Fleet Grid -->
      <div class="fleet-white-grid" id="dubaiFleetGrid">
        <% 
          const dubaiYachts = yachts.filter(y => y.location === 'Dubai' || (!y.location && !y.slug.endsWith('-miami')));
          dubaiYachts.forEach(yacht => { 
        %>
          <article class="yacht-card-white yacht-card-dubai" data-category="<%= yacht.category %>" data-length="<%= yacht.lengthFt %>">
            <div class="yacht-item-media">
              <img src="<%= yacht.primaryImage %>" alt="<%= yacht.title %>" loading="lazy">
              <div class="yacht-item-gradient"></div>
              <span class="port-badge-white">
                <i class="fas fa-anchor" style="color: #9e825a; margin-right: 4px;"></i> Dubai Marina
              </span>
            </div>

            <div class="yacht-item-body">
              <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 6px;">
                <h3 class="yacht-item-title"><%= yacht.title %></h3>
                <span style="font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; color: #9e825a; font-weight: 600;"><%= yacht.lengthFt %> FT</span>
              </div>

              <div class="yacht-item-specs">
                <%= yacht.capacity.replace(/pax/i, '').trim() || '20' %> Guests &middot; <%= yacht.specs['Build'] || 'Motor Yacht' %> &middot; <%= yacht.specs['Speed'] || '22 Knots' %>
              </div>

              <div class="yacht-item-footer">
                <div>
                  <div style="font-size: 0.65rem; letter-spacing: 0.16em; text-transform: uppercase; color: #64748b;">Charter Rate</div>
                  <div class="yacht-item-rate">
                    <% if (yacht.priceHourly.includes('[Price') || yacht.priceHourly.toLowerCase().includes('request')) { %>
                      Price on Request
                    <% } else { %>
                      <%= yacht.priceHourly.includes('AED') ? yacht.priceHourly : (yacht.priceHourly + ' AED') %> / hr
                    <% } %>
                  </div>
                </div>

                <a href="/yacht/<%= yacht.slug %>" class="btn-text-arrow">
                  <span>View Yacht</span>
                  <span class="arrow">&rarr;</span>
                </a>
              </div>
            </div>
          </article>
        <% }); %>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       SECTION 2: MIAMI FLEET VIEW
       ========================================================================= -->
  <section id="miamiFleetSection" class="destination-view section" style="padding-top: 50px; padding-bottom: 120px;">
    <div class="container">
      
      <!-- Elevative Miami Destination Hero Banner -->
      <div class="destination-elevative-banner">
        <div class="dest-banner-media" style="background-image: url('/assets/images/home/Image-4.jpg');"></div>
        <div class="dest-banner-gradient"></div>
        
        <div class="dest-banner-content">
          <div>
            <div class="eyebrow" style="color: #dfcaa8; margin-bottom: 8px;">Florida &middot; United States</div>
            <h2 class="dest-banner-title">The Miami Collection</h2>
            <p class="dest-banner-sub">
              Experience the pinnacle of private yachting along Biscayne Bay, South Beach, Star Island, Key Biscayne, and the Florida Keys.
            </p>
          </div>

          <div class="dest-banner-stats">
            <span>39 Vessels</span>
            <span>&bull;</span>
            <span>Biscayne Bay Moorings</span>
            <span>&bull;</span>
            <span>USCG Licensed Captains</span>
          </div>
        </div>
      </div>

      <!-- Miami Filter Controls -->
      <div class="fleet-filter-bar-white">
        <button type="button" class="filter-pill-white active" data-dest="miami" data-filter="all">All Miami Vessels (39)</button>
        <button type="button" class="filter-pill-white" data-dest="miami" data-filter="vip">Superyachts (100ft+)</button>
        <button type="button" class="filter-pill-white" data-dest="miami" data-filter="standard">Motor Yachts (45–90ft)</button>
        <button type="button" class="filter-pill-white" data-dest="miami" data-filter="mega">Mega Yachts (130ft+)</button>
      </div>

      <!-- Miami Fleet Grid -->
      <div class="fleet-white-grid" id="miamiFleetGrid">
        <% 
          const miamiYachts = yachts.filter(y => y.location === 'Miami' || y.slug.endsWith('-miami'));
          miamiYachts.forEach(yacht => { 
        %>
          <article class="yacht-card-white yacht-card-miami" data-category="<%= yacht.category %>" data-length="<%= yacht.lengthFt %>">
            <div class="yacht-item-media">
              <img src="<%= yacht.primaryImage %>" alt="<%= yacht.title %>" loading="lazy">
              <div class="yacht-item-gradient"></div>
              <span class="port-badge-white">
                <i class="fas fa-compass" style="color: #9e825a; margin-right: 4px;"></i> Miami & Biscayne
              </span>
            </div>

            <div class="yacht-item-body">
              <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 6px;">
                <h3 class="yacht-item-title"><%= yacht.title %></h3>
                <span style="font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; color: #9e825a; font-weight: 600;"><%= yacht.lengthFt %> FT</span>
              </div>

              <div class="yacht-item-specs">
                <%= yacht.capacity.replace(/pax/i, '').trim() || '20' %> Guests &middot; <%= yacht.specs['Build'] || 'Motor Yacht' %> &middot; <%= yacht.specs['Speed'] || '22 Knots' %>
              </div>

              <div class="yacht-item-footer">
                <div>
                  <div style="font-size: 0.65rem; letter-spacing: 0.16em; text-transform: uppercase; color: #64748b;">Charter Rate</div>
                  <div class="yacht-item-rate">
                    <% if (yacht.priceHourly.includes('[Price') || yacht.priceHourly.toLowerCase().includes('request')) { %>
                      Price on Request
                    <% } else { %>
                      <%= yacht.priceHourly.includes('USD') || yacht.priceHourly.includes('$') ? yacht.priceHourly : ('$' + yacht.priceHourly + ' USD') %> / hr
                    <% } %>
                  </div>
                </div>

                <a href="/yacht/<%= yacht.slug %>" class="btn-text-arrow">
                  <span>View Yacht</span>
                  <span class="arrow">&rarr;</span>
                </a>
              </div>
            </div>
          </article>
        <% }); %>
      </div>
    </div>
  </section>
</div>

<!-- SCRIPT FOR SEAMLESS DESTINATION SWITCHING & FILTERING -->
<script>
  function switchDestination(dest) {
    const dubaiSection = document.getElementById('dubaiFleetSection');
    const miamiSection = document.getElementById('miamiFleetSection');
    const tabDubai = document.getElementById('tabBtnDubai');
    const tabMiami = document.getElementById('tabBtnMiami');

    if (dest === 'dubai') {
      tabDubai.classList.add('active');
      tabDubai.setAttribute('aria-selected', 'true');
      tabMiami.classList.remove('active');
      tabMiami.setAttribute('aria-selected', 'false');

      // Smooth transition
      miamiSection.style.opacity = '0';
      miamiSection.style.transform = 'translateY(16px)';
      setTimeout(() => {
        miamiSection.classList.remove('active');
        dubaiSection.classList.add('active');
        // Force reflow
        void dubaiSection.offsetWidth;
        dubaiSection.style.opacity = '1';
        dubaiSection.style.transform = 'translateY(0)';
      }, 250);
    } else if (dest === 'miami') {
      tabMiami.classList.add('active');
      tabMiami.setAttribute('aria-selected', 'true');
      tabDubai.classList.remove('active');
      tabDubai.setAttribute('aria-selected', 'false');

      // Smooth transition
      dubaiSection.style.opacity = '0';
      dubaiSection.style.transform = 'translateY(16px)';
      setTimeout(() => {
        dubaiSection.classList.remove('active');
        miamiSection.classList.add('active');
        // Force reflow
        void miamiSection.offsetWidth;
        miamiSection.style.opacity = '1';
        miamiSection.style.transform = 'translateY(0)';
      }, 250);
    }

    // Update query param without reload
    const url = new URL(window.location);
    url.searchParams.set('destination', dest);
    window.history.replaceState({}, '', url);
  }

  // Handle URL query parameter on load
  document.addEventListener('DOMContentLoaded', () => {
    const urlParams = new URLSearchParams(window.location.search);
    const dest = urlParams.get('destination') || urlParams.get('dest');
    if (dest === 'miami') {
      switchDestination('miami');
    }

    // Filter pills within white theme
    document.querySelectorAll('.filter-pill-white').forEach(pill => {
      pill.addEventListener('click', () => {
        const dest = pill.getAttribute('data-dest');
        const filter = pill.getAttribute('data-filter');

        // Toggle active button within group
        document.querySelectorAll(`.filter-pill-white[data-dest="${dest}"]`).forEach(p => p.classList.remove('active'));
        pill.classList.add('active');

        // Filter appropriate cards
        const cards = document.querySelectorAll(dest === 'dubai' ? '.yacht-card-dubai' : '.yacht-card-miami');
        cards.forEach(card => {
          const category = card.getAttribute('data-category') || '';
          const length = parseInt(card.getAttribute('data-length') || '0', 10);

          if (filter === 'all') {
            card.style.display = 'flex';
          } else if (filter === 'vip') {
            card.style.display = (category.toLowerCase().includes('vip') || length >= 100) ? 'flex' : 'none';
          } else if (filter === 'standard') {
            card.style.display = (length < 100) ? 'flex' : 'none';
          } else if (filter === 'mega') {
            card.style.display = (length >= 130) ? 'flex' : 'none';
          }
        });
      });
    });
  });
</script>

<%- include('partials/footer') %>
