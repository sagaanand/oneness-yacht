<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Oneness Yachts | Private Superyacht Charters Dubai' %></title>
  <meta name="description" content="Private luxury yacht charters in Dubai. Hand-curated fleet of superyachts, bespoke ocean experiences, and discreet 5-star concierge service across the Arabian Gulf.">

  <!-- Favicon -->
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/images/common/favicon/apple-touch-icon.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/images/common/favicon/favicon-32x32.png">

  <!-- Fonts & Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

  <!-- Superyacht Design System Stylesheet -->
  <link rel="stylesheet" href="/css/luxury-theme.css">
</head>
<body>

  <!-- Floating Cinematic Header -->
  <header class="site-header" id="siteHeader">
    <div class="container">
      <div class="header-inner">
        <!-- Logo -->
        <a href="/" class="brand-logo" aria-label="Oneness Luxury Superyachts Dubai">
          <img src="/assets/images/logo-white.svg" alt="Oneness Luxury Yachts">
        </a>

        <!-- Desktop Navigation -->
        <nav class="main-nav" aria-label="Primary Navigation">
          <ul class="nav-links">
            <li><a href="/fleet" class="nav-link <%= typeof activeNav !== 'undefined' && activeNav === 'fleet' ? 'active' : '' %>">Yachts</a></li>
            <li><a href="/packages" class="nav-link <%= typeof activeNav !== 'undefined' && activeNav === 'packages' ? 'active' : '' %>">Experiences</a></li>
            <li><a href="/amenities" class="nav-link <%= typeof activeNav !== 'undefined' && activeNav === 'amenities' ? 'active' : '' %>">Services</a></li>
            <li><a href="/about" class="nav-link <%= typeof activeNav !== 'undefined' && activeNav === 'about' ? 'active' : '' %>">About</a></li>
            <li><a href="/contact" class="nav-link <%= typeof activeNav !== 'undefined' && activeNav === 'contact' ? 'active' : '' %>">Contact</a></li>
          </ul>
        </nav>

        <!-- Header Actions -->
        <div class="header-actions">
          <a href="/contact" class="header-cta-btn">
            Request A Charter
          </a>

          <!-- Mobile Toggle -->
          <button class="mobile-toggle" id="mobileMenuBtn" aria-label="Open Navigation Menu">
            <i class="fas fa-bars"></i>
          </button>
        </div>
      </div>
    </div>
  </header>

  <!-- Mobile Drawer Overlay -->
  <div class="drawer-overlay" id="drawerOverlay"></div>

  <!-- Mobile Drawer -->
  <aside class="mobile-drawer" id="mobileDrawer" aria-label="Mobile Navigation">
    <div class="mobile-drawer-header">
      <img src="/assets/images/logo-white.svg" alt="Oneness Yachts" style="height: 32px;">
      <button class="mobile-drawer-close" id="drawerCloseBtn" aria-label="Close Menu" style="color: var(--text-primary); font-size: 1.4rem;">
        <i class="fas fa-times"></i>
      </button>
    </div>

    <ul class="mobile-nav-links">
      <li><a href="/" class="mobile-nav-link">Home</a></li>
      <li><a href="/fleet" class="mobile-nav-link">The Fleet</a></li>
      <li><a href="/fleet?filter=vip" class="mobile-nav-link" style="font-size: 1.05rem; padding-left: 16px; color: var(--accent-champagne);">— VIP Superyachts (100ft+)</a></li>
      <li><a href="/fleet?filter=standard" class="mobile-nav-link" style="font-size: 1.05rem; padding-left: 16px; color: var(--accent-champagne);">— Motor Yachts</a></li>
      <li><a href="/packages" class="mobile-nav-link">Experiences & Packages</a></li>
      <li><a href="/amenities" class="mobile-nav-link">Onboard Services</a></li>
      <li><a href="/about" class="mobile-nav-link">The Maison</a></li>
      <li><a href="/contact" class="mobile-nav-link">Private Inquiries</a></li>
    </ul>

    <div style="margin-top: auto; padding-top: 32px;">
      <a href="/contact" class="btn-primary" style="width: 100%; text-align: center;">
        Request A Charter
      </a>
      <div style="margin-top: 18px; text-align: center;">
        <a href="https://wa.me/971585441134?text=Hello%20Oneness%20Yachts,%20I%20would%20like%20to%20inquire%20about%20a%20private%20charter." target="_blank" style="font-size: 0.78rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent-champagne);">
          <i class="fab fa-whatsapp" style="margin-right: 6px;"></i> WhatsApp Concierge
        </a>
      </div>
    </div>
  </aside>
