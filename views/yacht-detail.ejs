<%- include('partials/header', { title: yacht.title + ' (' + yacht.lengthFt + ' FT) | Oneness Luxury Yachts ' + (yacht.location === 'Miami' ? 'Miami' : 'Dubai'), activeNav: 'fleet' }) %>

<!-- MASSIVE FULL-WIDTH BROCHURE HERO -->
<section class="brochure-hero">
  <div class="brochure-hero-bg" style="background-image: url('<%= yacht.images[0] || yacht.primaryImage %>');"></div>
  <div class="brochure-hero-overlay"></div>

  <div class="container brochure-hero-content">
    <div class="eyebrow"><%= yacht.category %> &middot; <%= yacht.location === 'Miami' ? 'Miami, FL' : 'Dubai, UAE' %></div>
    <h1 class="editorial-title editorial-title-lg" style="margin-bottom: 8px;">
      <%= yacht.title %>
    </h1>
    <div style="font-size: 1.1rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-secondary); margin-bottom: 24px;">
      <%= yacht.lengthFt %> FT &middot; <%= yacht.specs['Build'] || 'Prestige Naval Architecture' %> &middot; <%= yacht.port || (yacht.location === 'Miami' ? 'Biscayne Bay & Miami Beach, FL' : 'Dubai Marina & Palm Jumeirah') %>
    </div>
  </div>
</section>

<!-- BROCHURE CONTENT & EDITORIAL SPECIFICATIONS -->
<section class="section section-spacious" style="background-color: var(--bg-void);">
  <div class="container">
    
    <!-- Editorial Specification Strip (Typography, spacing and thin separators instead of boxed dashboard cards) -->
    <div class="brochure-specs-strip">
      <div class="brochure-spec-item">
        <span class="brochure-spec-lbl">Length</span>
        <span class="brochure-spec-val"><%= yacht.lengthFt %> FT</span>
      </div>

      <div class="brochure-spec-item">
        <span class="brochure-spec-lbl">Guest Capacity</span>
        <span class="brochure-spec-val"><%= yacht.capacity.replace(/pax/i, '').trim() || '20' %> Guests</span>
      </div>

      <div class="brochure-spec-item">
        <span class="brochure-spec-lbl">Cruising Speed</span>
        <span class="brochure-spec-val"><%= yacht.specs['Speed'] || '22 Knots' %></span>
      </div>

      <div class="brochure-spec-item">
        <span class="brochure-spec-lbl">Crew Onboard</span>
        <span class="brochure-spec-val"><%= yacht.specs['Crew'] || 'Dedicated VIP Crew' %></span>
      </div>

      <div class="brochure-spec-item">
        <span class="brochure-spec-lbl">Hourly Charter</span>
        <span class="brochure-spec-val" style="color: var(--accent-champagne);">
          <% if (yacht.priceHourly.includes('[Price') || yacht.priceHourly.toLowerCase().includes('request')) { %>
            On Request
          <% } else { %>
            <%= yacht.priceHourly.includes('AED') ? yacht.priceHourly : (yacht.priceHourly + ' AED') %>
          <% } %>
        </span>
      </div>
    </div>

    <!-- Overview & Inquiry Split -->
    <div class="brochure-content-split">
      <!-- Left: Narrative & Technical Specifications -->
      <div>
        <div class="eyebrow">The Vessel</div>
        <h2 class="editorial-title" style="font-size: 2.2rem;">Overview & Architecture</h2>
        
        <p style="font-size: 1.15rem; line-height: 1.9; color: var(--text-secondary); font-weight: 300; margin-bottom: 40px;">
          <%= yacht.overview || ('The ' + yacht.title + ' represents the pinnacle of private maritime luxury in the Arabian Gulf. Meticulously maintained to Lloyd\'s Register standards, the vessel combines sweeping outdoor entertaining decks with sumptuously appointed staterooms and quiet oceanic cruising capability.') %>
        </p>

        <!-- Technical Specification List -->
        <div style="margin-top: 50px; padding-top: 40px; border-top: 1px solid var(--border-subtle);">
          <h3 style="font-family: var(--font-serif); font-size: 1.5rem; color: var(--text-primary); margin-bottom: 24px; letter-spacing: 0.04em;">
            Technical Specifications
          </h3>

          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; font-size: 0.95rem;">
            <% Object.entries(yacht.specs).forEach(([key, val]) => { %>
              <% if (val && !key.toLowerCase().includes('capacity') && !key.toLowerCase().includes('size')) { %>
                <div style="padding-bottom: 12px; border-bottom: 1px solid var(--border-subtle);">
                  <span style="color: var(--accent-champagne); display: block; font-size: 0.72rem; letter-spacing: 0.16em; text-transform: uppercase;"><%= key %></span>
                  <span style="color: var(--text-primary); font-weight: 400;"><%= val %></span>
                </div>
              <% } %>
            <% }); %>
          </div>
        </div>
      </div>

      <!-- Right: Direct Charter Request Drawer -->
      <div style="background-color: var(--bg-surface); border: 1px solid var(--border-hairline); padding: 40px; position: sticky; top: 120px;">
        <div class="eyebrow" style="margin-bottom: 8px;">Private Booking</div>
        <h3 style="font-family: var(--font-serif); font-size: 1.6rem; color: var(--text-primary); margin-bottom: 16px;">
          Charter This Vessel
        </h3>
        <p style="font-size: 0.9rem; color: var(--text-secondary); line-height: 1.7; margin-bottom: 24px;">
          Submit your dates for an immediate bespoke quotation including fuel, crew, soft beverages, and marina fees.
        </p>

        <form class="inquiry-form" id="yachtDetailInquiryForm">
          <input type="hidden" name="yacht" value="<%= yacht.title %> (<%= yacht.lengthFt %> FT)">
          <div class="form-alert-box"></div>

          <div class="form-field" style="margin-bottom: 18px;">
            <label class="form-label" for="detailName">Full Name *</label>
            <input type="text" id="detailName" name="name" class="form-input" placeholder="Your Name" required>
          </div>

          <div class="form-field" style="margin-bottom: 18px;">
            <label class="form-label" for="detailPhone">Phone Number *</label>
            <input type="tel" id="detailPhone" name="phone" class="form-input" placeholder="+971 50 000 0000" required>
          </div>

          <div class="form-field" style="margin-bottom: 18px;">
            <label class="form-label" for="detailDate">Preferred Date</label>
            <input type="date" id="detailDate" name="date" class="form-input">
          </div>

          <div class="form-field" style="margin-bottom: 24px;">
            <label class="form-label" for="detailGuests">Guests</label>
            <input type="text" id="detailGuests" name="guests" class="form-input" placeholder="e.g. 10 Guests">
          </div>

          <button type="submit" class="btn-primary" style="width: 100%;">
            Request Quotation &rarr;
          </button>
        </form>

        <div style="margin-top: 20px; text-align: center;">
          <a href="https://wa.me/971585441134?text=Hello%20Oneness%20Yachts,%20I%20am%20interested%20in%20chartering%20<%= encodeURIComponent(yacht.title) %>%20(<%= yacht.lengthFt %>FT)." target="_blank" class="btn-text-arrow">
            <i class="fab fa-whatsapp" style="margin-right: 6px;"></i>
            <span>Chat On WhatsApp</span>
            <span class="arrow">&rarr;</span>
          </a>
        </div>
      </div>
    </div>

    <!-- IMMERSIVE PHOTOGRAPHY GALLERY (MASONRY/ASYMMETRIC LAYOUT) -->
    <div style="margin-top: 100px; padding-top: 80px; border-top: 1px solid var(--border-subtle);">
      <div class="eyebrow">Visual Journey</div>
      <h2 class="editorial-title" style="margin-bottom: 40px;">Vessel Gallery</h2>

      <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px;">
        <% (yacht.images && yacht.images.length > 0 ? yacht.images : [yacht.primaryImage]).forEach((img, idx) => { %>
          <div class="gallery-photo-card" style="position: relative; height: 320px; overflow: hidden; background-color: var(--bg-surface); border: 1px solid var(--border-subtle); cursor: pointer;" onclick="openLightbox('<%= img %>')">
            <img src="<%= img %>" alt="<%= yacht.title %> photography <%= idx + 1 %>" style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.8s var(--ease-cinematic);" loading="lazy" onmouseover="this.style.transform='scale(1.06)'" onmouseout="this.style.transform='scale(1)'">
            <div style="position: absolute; inset: 0; background: linear-gradient(180deg, transparent 60%, rgba(2,5,11,0.6) 100%); pointer-events: none;"></div>
          </div>
        <% }); %>
      </div>
    </div>

  </div>
</section>

<!-- STICKY DOCKED BOTTOM BAR (CONCIERGE QUICK CONVERSION) -->
<div class="sticky-charter-bar">
  <div class="container sticky-bar-inner">
    <div class="sticky-bar-info">
      <div>
        <span style="font-family: var(--font-serif); font-size: 1.2rem; color: var(--text-primary); display: block;"><%= yacht.title %></span>
        <span style="font-size: 0.75rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent-champagne);"><%= yacht.lengthFt %> FT &middot; <%= yacht.capacity.replace(/pax/i, '').trim() || '20' %> Guests</span>
      </div>
    </div>

    <div style="display: flex; align-items: center; gap: 16px;">
      <a href="#yachtDetailInquiryForm" class="btn-primary" style="padding: 12px 28px; font-size: 0.75rem;">
        Request This Yacht &rarr;
      </a>
      <a href="https://wa.me/971585441134?text=Hello%20Oneness%20Yachts,%20I%20am%20interested%20in%20chartering%20<%= encodeURIComponent(yacht.title) %>%20(<%= yacht.lengthFt %>FT)." target="_blank" class="btn-secondary" style="padding: 11px 20px; font-size: 0.75rem;">
        <i class="fab fa-whatsapp" style="margin-right: 6px;"></i> WhatsApp
      </a>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
