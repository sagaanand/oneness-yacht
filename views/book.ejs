});

document.getElementById('sendEmailOtpBtn').addEventListener('click', async () => {
  const email = document.getElementById('auth-email-input').value.trim();
  if (!email || !email.includes('@')) { showError('Please enter a valid email address.'); return; }
  const name = document.getElementById('auth-name-input').value.trim();

  showLoader('Sending code...');
  try {
    const res = await fetch('/api/v1/auth/send-otp', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ identifier: email, identifierType: 'EMAIL', name })
    });
    const data = await res.json();
    hideLoader();

    if (data.success) {
      document.getElementById('email-form').style.display = 'none';
      document.getElementById('email-otp-form').style.display = 'block';
      document.getElementById('emailOtpTarget').textContent = email;
      if (data.devMode && data.otp) {
        document.getElementById('dev-otp-hint').style.display = 'block';
        document.getElementById('devOtpCode').textContent = data.otp;
      }
      setupOtpInputs('emailOtpFields');
    } else {
      showError(data.error || 'Failed to send OTP. Try again.');
    }
  } catch { hideLoader(); showError('Network error. Please retry.'); }
});

document.getElementById('verifyEmailOtpBtn').addEventListener('click', async () => {
  const code = getOtpValue('emailOtpFields');
  if (code.length < 6) { showError('Enter all 6 digits.'); return; }
  const email = document.getElementById('auth-email-input').value.trim();
  const name = document.getElementById('auth-name-input').value.trim();
  await verifyOTP('EMAIL', email, code, { name, email });
});

