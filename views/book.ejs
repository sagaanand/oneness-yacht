async function verifyOTP(type, identifier, code, customerInfo) {
  showLoader('Verifying...');
  try {
    const res = await fetch('/api/v1/auth/verify-otp', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ identifier, identifierType: type, code, customerInfo })
    });
    const data = await res.json();
    hideLoader();

    if (data.success) {
      state.customer = data.customer;
      await createBookingAndPay();
    } else {
      showError(data.error || 'Invalid code. Please try again.');
    }
  } catch { hideLoader(); showError('Verification failed. Please retry.'); }
}

// ============================================================
// BOOKING + PAYMENT
// ============================================================
async function createBookingAndPay() {
  showLoader('Creating your booking...');
  const startISO = new Date(`${state.date}T${state.time}:00`).toISOString();
  const endISO = new Date(new Date(`${state.date}T${state.time}:00`).getTime() + state.duration * 3600000).toISOString();

  try {
    const res = await fetch('/api/v1/bookings', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        yachtId: state.yachtId,
        startTime: startISO,
        endTime: endISO,
        guests: state.guests,
        holdToken: state.holdToken,
        addonIds: state.addons.map(a => a.id),
        paymentMethod: 'CARD_ONLINE'
      })
    });
    const bookData = await res.json();

    if (!bookData.success) {
      hideLoader();
      showError(bookData.error || 'Booking failed. Your hold may have expired.');
      return;
    }

    state.bookingId = bookData.bookingId;
    state.bookingRef = bookData.bookingRef;

    // Create Stripe PaymentIntent
    const piRes = await fetch('/api/v1/payments/create-intent', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ bookingId: state.bookingId })
    });
    const piData = await piRes.json();
    hideLoader();

    if (!piData.success) {
      showError(piData.error || 'Payment setup failed. Please contact concierge.');
      return;
    }

    if (piData.mode === 'DEMO') {
      // Demo mode: show confirmation page directly (simulate payment)
      const simulateRes = await fetch('/api/v1/payments/initiate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Idempotency-Key': `bk_${state.bookingId}` },
        body: JSON.stringify({ bookingId: state.bookingId, paymentMethod: 'CARD_ONLINE', gateway: 'STRIPE' })
      });
      window.location.href = `/booking-confirmed?ref=${state.bookingRef}`;
    } else {
      // Real Stripe: redirect or mount payment element
      // For full Stripe.js integration, mount Elements here
      // For now, store client_secret and redirect
      window.location.href = `/payment?bookingId=${state.bookingId}&client_secret=${piData.clientSecret}`;
    }
  } catch (err) {
    hideLoader();
    showError('An error occurred. Please contact concierge.');
  }
}

// ============================================================
// HOLD TIMER
// ============================================================
function startHoldTimer() {
  if (holdTimerInterval) clearInterval(holdTimerInterval);
  holdTimerInterval = setInterval(() => {
    const remaining = state.holdExpiresAt - new Date();
    if (remaining <= 0) {
      clearInterval(holdTimerInterval);
      document.getElementById('holdTimer').textContent = '00:00';
      document.getElementById('holdTimer').className = 'hold-timer--urgent';
      showError('Your hold has expired. Please start a new booking.');
      return;
    }
    const mins = Math.floor(remaining / 60000);
    const secs = Math.floor((remaining % 60000) / 1000);
    const timerEl = document.getElementById('holdTimer');
    timerEl.textContent = `${String(mins).padStart(2,'0')}:${String(secs).padStart(2,'0')}`;
    if (remaining < 120000) timerEl.style.color = '#ef4444';
    else if (remaining < 300000) timerEl.style.color = '#f59e0b';
  }, 1000);
}

// ============================================================
// OTP INPUT HELPERS
// ============================================================
function setupOtpInputs(containerId) {
  const inputs = document.querySelectorAll(`#${containerId} .otp-input`);
  inputs.forEach((input, i) => {
    input.addEventListener('input', (e) => {
      if (e.data && /[0-9]/.test(e.data) && i < inputs.length - 1) inputs[i + 1].focus();
    });
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Backspace' && !input.value && i > 0) inputs[i - 1].focus();
    });
    input.addEventListener('paste', (e) => {
      const pasted = e.clipboardData.getData('text').replace(/\D/g,'');
      inputs.forEach((inp, j) => { inp.value = pasted[j] || ''; });
      e.preventDefault();
    });
  });
  inputs[0].focus();
}

function getOtpValue(containerId) {
  return Array.from(document.querySelectorAll(`#${containerId} .otp-input`)).map(i => i.value).join('');
}

// ============================================================
// SUMMARY HELPERS
// ============================================================
function updateSummary(id, val) { const el = document.getElementById(id); if (el) el.textContent = val; }
function renderSummary() {
  if (state.date) updateSummary('sum-date', formatDate(state.date));
  if (state.time) updateSummary('sum-time', formatTime(state.time));
  if (state.duration) updateSummary('sum-duration', `${state.duration} hours`);
  updateSummary('sum-guests', `${state.guests} guests`);
}

// ============================================================
// LOADER / ERROR
// ============================================================
function showLoader(msg) {
  document.getElementById('globalLoading').classList.add('active');
  document.getElementById('loadingText').textContent = msg || 'Loading...';
}
function hideLoader() { document.getElementById('globalLoading').classList.remove('active'); }
function showError(msg) {
  const el = document.getElementById('wizardError');
  el.textContent = msg;
  el.style.display = 'block';
  el.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
}
function clearError() { document.getElementById('wizardError').style.display = 'none'; }

// ============================================================
// FORMAT HELPERS
// ============================================================
function formatDate(d) {
  if (!d) return '—';
  return new Date(d + 'T12:00:00').toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' });
}
function formatTime(t) {
  if (!t) return '—';
  const [h, m] = t.split(':');
  const hr = parseInt(h);
  const ampm = hr >= 12 ? 'PM' : 'AM';
  const hr12 = hr % 12 || 12;
  return `${hr12}:${m} ${ampm}`;
}

