<%- include('partials/head', {
  title: 'Secure Yacht Payment — Oneness Yachts Dubai',
  description: 'Complete your luxury yacht charter reservation with 256-bit encrypted checkout.'
}) %>

<%- include('partials/header', { activeNav: '' }) %>

<script src="https://js.stripe.com/v3/"></script>

<style>
.payment-section {
  background: radial-gradient(circle at 50% 20%, #0d1e38 0%, #040912 100%);
  min-height: 85vh;
  padding: 130px 24px 80px;
  color: #fff;
}
.payment-grid {
  max-width: 1080px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1fr 420px;
  gap: 36px;
  align-items: start;
}
@media (max-width: 860px) {
  .payment-grid {
    grid-template-columns: 1fr;
  }
}
.payment-box {
  background: rgba(13,27,46,0.85);
  backdrop-filter: blur(16px);
  border: 1px solid rgba(201,166,107,0.3);
  border-radius: 20px;
  padding: 32px;
  box-shadow: 0 20px 50px rgba(0,0,0,0.5);
}
.hold-timer-bar {
  background: rgba(245,158,11,0.12);
  border: 1px solid rgba(245,158,11,0.35);
  border-radius: 12px;
  padding: 12px 18px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24px;
}
.timer-count {
  font-family: monospace;
  font-size: 18px;
  font-weight: 700;
  color: #f59e0b;
}
.stripe-form-group {
  margin-bottom: 20px;
}
.stripe-input-box {
  background: #071224;
  border: 1px solid rgba(255,255,255,0.15);
  border-radius: 10px;
  padding: 14px 16px;
  transition: border-color 0.2s;
}
.stripe-input-box:focus-within {
  border-color: #c9a66b;
  box-shadow: 0 0 0 2px rgba(201,166,107,0.2);
}
.order-summary-card {
  background: #081324;
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: 18px;
  padding: 28px;
}
.summary-line {
  display: flex;
  justify-content: space-between;
  font-size: 14px;
  color: #94a3b8;
  margin-bottom: 12px;
}
.summary-total {
  border-top: 1px solid rgba(255,255,255,0.1);
  padding-top: 16px;
  margin-top: 16px;
  display: flex;
  justify-content: space-between;
  font-size: 20px;
  font-weight: 700;
  color: #f8fafc;
}
.btn-pay {
  width: 100%;
  background: linear-gradient(135deg, #c9a66b, #9a7633);
  color: #040912;
  font-weight: 800;
  font-size: 16px;
  padding: 16px;
  border-radius: 10px;
  border: none;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  margin-top: 24px;
  box-shadow: 0 4px 20px rgba(201,166,107,0.3);
  transition: opacity 0.2s ease;
}
.btn-pay:hover:not(:disabled) {
  opacity: 0.93;
}
.btn-pay:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}
.mock-toggle {
  margin-top: 16px;
  padding: 12px;
  background: rgba(255,255,255,0.03);
  border: 1px dashed rgba(201,166,107,0.3);
  border-radius: 8px;
  font-size: 12px;
  color: #cbd5e1;
}
</style>

<div class="payment-section">
  <div class="payment-grid">
    <!-- Left Column: Payment Form -->
    <div class="payment-box">
      <div class="hold-timer-bar">
        <div style="display: flex; align-items: center; gap: 8px; font-size: 13px; color: #fbbf24;">
          <i class="fa-regular fa-clock"></i>
          <span>Vessel Reserved For:</span>
        </div>
        <div class="timer-count" id="holdCountdown">14:59</div>
      </div>

      <h2 style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: 32px; color: #f9f5ee; margin-bottom: 8px;">
        Payment Details
      </h2>
      <p style="color: #94a3b8; font-size: 14px; margin-bottom: 28px;">
        <i class="fa-solid fa-lock" style="color: #10b981; margin-right: 6px;"></i>
        256-bit SSL encrypted PCI-DSS compliant checkout.
      </p>

      <form id="payment-form">
        <div class="stripe-form-group">
          <label style="display: block; font-size: 13px; color: #cbd5e1; margin-bottom: 8px; font-weight: 500;">Cardholder Full Name</label>
          <input type="text" id="cardholder-name" class="stripe-input-box" style="width: 100%; color: #fff; font-size: 15px; outline: none;" placeholder="e.g. Sheikh Mohammed / Alexander Wright" required>
        </div>

        <div class="stripe-form-group">
          <label style="display: block; font-size: 13px; color: #cbd5e1; margin-bottom: 8px; font-weight: 500;">Card Details</label>
          <div id="card-element" class="stripe-input-box">
            <!-- Stripe Card Element mounts here -->
          </div>
          <div id="card-errors" style="color: #f87171; font-size: 13px; margin-top: 8px;" role="alert"></div>
        </div>

        <button type="submit" id="submit-btn" class="btn-pay">
          <i class="fa-solid fa-lock"></i>
          <span>Authorize & Confirm Charter</span>
        </button>

        <!-- Sandbox / Quick Checkout Simulation for Review & QA -->
        <div class="mock-toggle" id="qaTestSection">
          <div style="display: flex; justify-content: space-between; align-items: center;">
            <span><i class="fa-solid fa-flask" style="color: #c9a66b; margin-right: 6px;"></i> Instant QA Simulation Mode</span>
            <button type="button" onclick="simulateTestPayment()" style="background: rgba(201,166,107,0.2); color: #c9a66b; border: 1px solid #c9a66b; border-radius: 6px; padding: 4px 10px; font-size: 11px; cursor: pointer; font-weight: 700;">
              Instant Settle
            </button>
          </div>
          <p style="margin-top: 6px; font-size: 11px; color: #64748b;">
            Enabled for testing in environments without live Stripe webhook listeners.
          </p>
        </div>
      </form>
    </div>

    <!-- Right Column: Charter Summary -->
    <div class="order-summary-card">
      <h3 style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: 24px; color: #c9a66b; margin-bottom: 16px;">
        Charter Summary
      </h3>

      <div style="display: flex; gap: 14px; margin-bottom: 20px; align-items: center;">
        <div style="width: 52px; height: 52px; border-radius: 10px; background: rgba(201,166,107,0.15); border: 1px solid rgba(201,166,107,0.3); display: flex; align-items: center; justify-content: center; color: #c9a66b; font-size: 22px;">
          <i class="fa-solid fa-ship"></i>
        </div>
        <div>
          <div style="font-weight: 700; color: #f8fafc; font-size: 16px;" id="summaryYachtTitle">Loading charter...</div>
          <div style="color: #94a3b8; font-size: 13px;" id="summaryLocation">Dubai Marina, Berth 4</div>
        </div>
      </div>

      <div class="summary-line">
        <span>Booking Reference</span>
        <strong style="color: #c9a66b; font-family: monospace;" id="summaryRef">#ONY-...</strong>
      </div>
      <div class="summary-line">
        <span>Date & Departure</span>
        <span id="summaryDate" style="color: #f1f5f9;">Today</span>
      </div>
      <div class="summary-line">
        <span>Duration & Guests</span>
        <span id="summaryGuests" style="color: #f1f5f9;">3h • 10 Guests</span>
      </div>

      <div style="border-top: 1px solid rgba(255,255,255,0.06); margin: 16px 0;"></div>

      <div class="summary-line">
        <span>Vessel Charter Rate</span>
        <span id="summaryBaseRate">0 AED</span>
      </div>
      <div class="summary-line">
        <span>Selected Add-ons</span>
        <span id="summaryAddons">0 AED</span>
      </div>
      <div class="summary-line">
        <span>UAE VAT (5%)</span>
        <span id="summaryVat">0 AED</span>
      </div>

      <div class="summary-total">
        <span>Total Payable</span>
        <span style="color: #c9a66b;" id="summaryTotal">0 AED</span>
      </div>

      <div style="margin-top: 24px; padding: 14px; background: rgba(255,255,255,0.02); border-radius: 10px; border: 1px solid rgba(255,255,255,0.06); font-size: 12px; color: #94a3b8; line-height: 1.5;">
        <i class="fa-solid fa-shield-halved" style="color: #c9a66b; margin-right: 4px;"></i>
        Full refund available up to 72 hours prior to departure. 50% refund up to 24 hours prior.
      </div>
    </div>
  </div>
</div>

<script>
const bookingId = '<%= bookingId %>';
let clientSecret = '<%= clientSecret %>';
let stripe = null;
let cardElement = null;
let bookingData = null;

// Initialize Stripe if publishable key is present
const stripeKey = '<%= process.env.STRIPE_PUBLISHABLE_KEY || "" %>';
if (stripeKey && typeof Stripe !== 'undefined') {
  stripe = Stripe(stripeKey);
  const elements = stripe.elements();
  cardElement = elements.create('card', {
    style: {
      base: {
        color: '#ffffff',
        fontFamily: 'Inter, sans-serif',
        fontSize: '15px',
        '::placeholder': { color: '#64748b' }
      },
      invalid: { color: '#f87171' }
    }
  });
  cardElement.mount('#card-element');
} else {
  // Graceful fallback for dev/demo mode
  document.getElementById('card-element').innerHTML = `
    <div style="display: flex; gap: 10px; align-items: center;">
      <input type="text" placeholder="4242 •••• •••• 4242" class="demo-card-input" style="background: none; border: none; color: #fff; width: 60%; outline: none;">
      <input type="text" placeholder="MM/YY" style="background: none; border: none; color: #fff; width: 20%; outline: none;">
      <input type="text" placeholder="CVC" style="background: none; border: none; color: #fff; width: 20%; outline: none;">
    </div>
  `;
}

// Fetch booking details
async function fetchBookingDetails() {
  if (!bookingId) return;
  try {
    const res = await fetch(`/api/v1/bookings/${bookingId}`);
    const data = await res.json();
    if (data.success && data.booking) {
      bookingData = data.booking;
      populateSummary(bookingData);
    }
  } catch (err) {
    console.error('Failed to load booking:', err);
  }
}

function populateSummary(b) {
  document.getElementById('summaryRef').textContent = '#' + (b.bookingRef || b.booking_ref || 'ONY');
  document.getElementById('summaryYachtTitle').textContent = b.yachtTitle || b.yacht_title || 'Luxury Yacht';
  document.getElementById('summaryLocation').textContent = (b.marina || 'Dubai Marina') + (b.berth ? ` • ${b.berth}` : '');
  
  if (b.startTime || b.start_time) {
    const start = new Date(b.startTime || b.start_time);
    document.getElementById('summaryDate').textContent = start.toLocaleDateString('en-AE', { day: 'numeric', month: 'short', year: 'numeric' });
  }
  
  const total = parseFloat(b.totalPrice || b.total_price || 0);
  const vat = total - (total / 1.05);
  const subtotal = total - vat;

  document.getElementById('summaryBaseRate').textContent = Math.round(subtotal).toLocaleString() + ' AED';
  document.getElementById('summaryVat').textContent = Math.round(vat).toLocaleString() + ' AED';
  document.getElementById('summaryTotal').textContent = total.toLocaleString() + ' AED';
}

// 15-minute hold timer countdown
let secondsLeft = 15 * 60;
const timerInterval = setInterval(() => {
  secondsLeft--;
  if (secondsLeft <= 0) {
    clearInterval(timerInterval);
    document.getElementById('holdCountdown').textContent = 'EXPIRED';
    alert('Your checkout hold window has expired. Please reselect your charter slot.');
    window.location.href = '/book';
    return;
  }
  const mins = Math.floor(secondsLeft / 60).toString().padStart(2, '0');
  const secs = (secondsLeft % 60).toString().padStart(2, '0');
  document.getElementById('holdCountdown').textContent = `${mins}:${secs}`;
}, 1000);

// Form submission
document.getElementById('payment-form').addEventListener('submit', async (e) => {
  e.preventDefault();
  const btn = document.getElementById('submit-btn');
  btn.disabled = true;
  btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Authorizing...';

  if (stripe && clientSecret && cardElement) {
    const cardholder = document.getElementById('cardholder-name').value;
    const { error, paymentIntent } = await stripe.confirmCardPayment(clientSecret, {
      payment_method: {
        card: cardElement,
        billing_details: { name: cardholder }
      }
    });

    if (error) {
      document.getElementById('card-errors').textContent = error.message;
      btn.disabled = false;
      btn.innerHTML = '<i class="fa-solid fa-lock"></i> Authorize & Confirm Charter';
    } else if (paymentIntent && paymentIntent.status === 'succeeded') {
      window.location.href = `/booking-confirmed?ref=${bookingData ? bookingData.booking_ref : ''}&token=${bookingData ? bookingData.boarding_access_token : ''}`;
    }
  } else {
    // Development or direct settlement via API
    await simulateTestPayment();
  }
});

async function simulateTestPayment() {
  const btn = document.getElementById('submit-btn');
  btn.disabled = true;
  btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Processing Secure Payment...';

  try {
    const res = await fetch('/api/v1/payments/confirm', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        bookingId: bookingId,
        idempotencyKey: 'pay_' + Date.now(),
        cardholderName: document.getElementById('cardholder-name').value || 'Charter Guest'
      })
    });
    const result = await res.json();
    if (result.success) {
      window.location.href = `/booking-confirmed?ref=${result.bookingRef || ''}&token=${result.boardingAccessToken || ''}`;
    } else {
      alert('Payment processing: ' + (result.error || 'Failed'));
      btn.disabled = false;
      btn.innerHTML = '<i class="fa-solid fa-lock"></i> Authorize & Confirm Charter';
    }
  } catch (err) {
    console.error(err);
    // Fallback redirect
    window.location.href = `/booking-confirmed?ref=${bookingData ? (bookingData.booking_ref || bookingData.bookingRef) : ''}`;
  }
}

document.addEventListener('DOMContentLoaded', fetchBookingDetails);
</script>

<%- include('partials/footer') %>
