<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Availability & Schedule Management — Oneness Yachts Operations</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@700&display=swap" rel="stylesheet">
  <style>
    :root {
      --navy: #07111c;
      --gold: #c9a66b;
      --card-bg: #0d1a29;
      --border: rgba(255, 255, 255, 0.08);
      --muted: #71808c;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      background: #060e18;
      color: #e2e8f0;
      font-family: 'Inter', sans-serif;
      min-height: 100vh;
    }
    .admin-container {
      max-width: 1440px;
      margin: 0 auto;
      padding: 32px 24px;
    }
    .page-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 28px;
      flex-wrap: wrap;
      gap: 16px;
    }
    .kicker {
      font-size: 11px;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: var(--gold);
      font-weight: 700;
      margin-bottom: 4px;
    }
    .page-title {
      font-family: Georgia, serif;
      font-size: 32px;
      color: #fff;
    }
    .btn-gold {
      background: linear-gradient(135deg, #c9a66b, #9a7633);
      color: #040912;
      font-weight: 700;
      padding: 10px 18px;
      border-radius: 8px;
      border: none;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: 13px;
    }
    .avail-grid {
      display: grid;
      grid-template-columns: 360px 1fr;
      gap: 28px;
    }
    @media (max-width: 960px) {
      .avail-grid { grid-template-columns: 1fr; }
    }
    .card {
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 24px;
      margin-bottom: 24px;
    }
    .card-title {
      font-family: Georgia, serif;
      font-size: 20px;
      color: #fff;
      margin-bottom: 16px;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .label {
      display: block;
      font-size: 12px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: #cbd5e1;
      margin-bottom: 6px;
    }
    .input, select {
      width: 100%;
      background: #071220;
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 6px;
      padding: 10px 12px;
      color: #fff;
      font-size: 13px;
      outline: none;
      margin-bottom: 14px;
    }
    .block-card {
      background: rgba(255,255,255,0.02);
      border: 1px solid rgba(255,255,255,0.06);
      border-radius: 8px;
      padding: 14px;
      margin-bottom: 12px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .timeline-bar-wrap {
      background: #071220;
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 20px;
      overflow-x: auto;
    }
    .hours-row {
      display: grid;
      grid-template-columns: repeat(16, minmax(60px, 1fr));
      border-bottom: 1px solid rgba(255,255,255,0.06);
      padding-bottom: 8px;
      margin-bottom: 14px;
      font-size: 11px;
      color: var(--muted);
      text-align: center;
    }
    .vessel-row {
      display: grid;
      grid-template-columns: 140px 1fr;
      align-items: center;
      padding: 12px 0;
      border-bottom: 1px solid rgba(255,255,255,0.04);
    }
    .vessel-track {
      height: 36px;
      background: rgba(255,255,255,0.03);
      border-radius: 6px;
      position: relative;
    }
    .block-tag {
      position: absolute;
      top: 4px;
      bottom: 4px;
      border-radius: 4px;
      font-size: 11px;
      padding: 4px 8px;
      display: flex;
      align-items: center;
      color: #fff;
      font-weight: 600;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .block-confirmed { background: rgba(16,185,129,0.8); }
    .block-maint { background: rgba(239,68,68,0.8); }
  </style>
</head>
<body>

  <%- include('nav-header', { activeTab: 'availability', adminUser: adminUser }) %>

  <div class="admin-container">
    <div class="page-header">
      <div>
        <div class="kicker">Schedule & Turnaround Engine</div>
        <h1 class="page-title">Fleet Availability & Maintenance</h1>
      </div>
      <div>
        <button onclick="document.getElementById('maintYacht').focus()" class="btn-gold">
          <i class="fa-solid fa-ban"></i> Schedule Maintenance Block
        </button>
      </div>
    </div>

    <div class="avail-grid">
      <!-- Left Column: New Block & Operating Hours Form -->
      <div>
        <!-- Create Maintenance / Blackout Block -->
        <div class="card">
          <div class="card-title"><i class="fa-solid fa-wrench" style="color: var(--gold);"></i> Blackout & Maintenance</div>
          <p style="font-size: 13px; color: var(--muted); margin-bottom: 16px;">
            Reserve vessel time for routine hull cleaning, mechanical repairs, refueling, or private VIP hold.
          </p>

          <form id="maintForm">
            <label class="label">Target Vessel</label>
            <select id="maintYacht" required>
              <option value="">Select Yacht...</option>
            </select>

            <label class="label">Start Time</label>
            <input type="datetime-local" id="maintStart" class="input" required>

            <label class="label">End Time</label>
            <input type="datetime-local" id="maintEnd" class="input" required>

            <label class="label">Reason / Category</label>
            <select id="maintReason">
              <option value="Mechanical / Engine Service">Mechanical / Engine Service</option>
              <option value="Hull Cleaning & Polishing">Hull Cleaning & Polishing</option>
              <option value="Drydock / Annual Survey">Drydock / Annual Survey</option>
              <option value="Private Owner Reserve">Private Owner Reserve</option>
              <option value="Coast Guard Inspection">Coast Guard Inspection</option>
            </select>

            <button type="submit" class="btn-gold" style="width: 100%; justify-content: center;">
              <i class="fa-solid fa-lock"></i> Apply Blackout Block
            </button>
          </form>
        </div>

        <!-- Active Maintenance Blocks -->
        <div class="card">
          <div class="card-title"><i class="fa-solid fa-list-check" style="color: var(--gold);"></i> Active Maintenance Holds</div>
          <div id="maintList">
            <p style="color: var(--muted); font-size: 13px;">Loading active holds...</p>
          </div>
        </div>
      </div>

      <!-- Right Column: Interactive Schedule Timeline View -->
      <div>
        <div class="card">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
            <div class="card-title" style="margin: 0;"><i class="fa-solid fa-timeline" style="color: var(--gold);"></i> Today's Schedule Overview</div>
            <div style="display: flex; gap: 12px; font-size: 12px;">
              <span style="display: flex; align-items: center; gap: 4px;"><span style="width: 10px; height: 10px; border-radius: 2px; background: rgba(16,185,129,0.8);"></span> Charter</span>
              <span style="display: flex; align-items: center; gap: 4px;"><span style="width: 10px; height: 10px; border-radius: 2px; background: rgba(239,68,68,0.8);"></span> Maintenance</span>
            </div>
          </div>

          <div class="timeline-bar-wrap">
            <div class="hours-row">
              <span>08:00</span><span>09:00</span><span>10:00</span><span>11:00</span>
              <span>12:00</span><span>13:00</span><span>14:00</span><span>15:00</span>
              <span>16:00</span><span>17:00</span><span>18:00</span><span>19:00</span>
              <span>20:00</span><span>21:00</span><span>22:00</span><span>23:00</span>
            </div>

            <div id="vesselsTimeline">
              <!-- Rendered via script -->
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
  let fleet = [];

  async function init() {
    // Set default datetime to today
    const now = new Date();
    const todayStr = now.toISOString().slice(0, 16);
    document.getElementById('maintStart').value = todayStr;
    const later = new Date(now.getTime() + 4 * 3600 * 1000);
    document.getElementById('maintEnd').value = later.toISOString().slice(0, 16);

    await loadFleet();
    await loadMaintenance();
  }

  async function loadFleet() {
    try {
      const res = await fetch('/api/v1/yachts');
      const data = await res.json();
      if (data.success) {
        fleet = data.yachts;
        const sel = document.getElementById('maintYacht');
        sel.innerHTML = '<option value="">Select Yacht...</option>' +
          fleet.map(y => `<option value="${y.id || y.slug}">${y.title} (${y.length_ft || y.lengthFt} FT)</option>`).join('');

        renderTimeline(fleet);
      }
    } catch (e) { console.error(e); }
  }

  function renderTimeline(yachts) {
    const container = document.getElementById('vesselsTimeline');
    container.innerHTML = yachts.slice(0, 8).map(y => `
      <div class="vessel-row">
        <div style="font-size: 13px; font-weight: 600; color: #fff; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; padding-right: 10px;">
          ${y.title}
        </div>
        <div class="vessel-track">
          <!-- Demo sample slots for visual clarity -->
          <div class="block-tag block-confirmed" style="left: 20%; width: 25%;">
            Charter ONY-2951
          </div>
        </div>
      </div>
    `).join('');
  }

  async function loadMaintenance() {
    try {
      const res = await fetch('/api/v1/admin/maintenance');
      const data = await res.json();
      const list = document.getElementById('maintList');
      if (data.success && data.blocks && data.blocks.length > 0) {
        list.innerHTML = data.blocks.map(b => `
          <div class="block-card">
            <div>
              <div style="font-weight: 600; color: #fff; font-size: 13px;">${b.title || 'Yacht'}</div>
              <div style="font-size: 12px; color: var(--muted);">${new Date(b.start_time).toLocaleString('en-AE')}</div>
              <div style="font-size: 11px; color: #f87171; margin-top: 2px;">${b.reason}</div>
            </div>
            <button onclick="deleteBlock('${b.id}')" style="background: none; border: 1px solid rgba(239,68,68,0.3); color: #f87171; border-radius: 4px; padding: 4px 8px; cursor: pointer; font-size: 11px;">
              Release
            </button>
          </div>
        `).join('');
      } else {
        list.innerHTML = '<p style="color: var(--muted); font-size: 13px;">No active blackout blocks.</p>';
      }
    } catch (e) { console.error(e); }
  }

  document.getElementById('maintForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const payload = {
      yachtId: document.getElementById('maintYacht').value,
      startTime: document.getElementById('maintStart').value,
      endTime: document.getElementById('maintEnd').value,
      reason: document.getElementById('maintReason').value,
      blockedBy: 'Fleet Admin'
    };

    try {
      const res = await fetch('/api/v1/admin/maintenance', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const data = await res.json();
      if (data.success) {
        alert('Blackout block registered successfully.');
        loadMaintenance();
      } else {
        alert(data.error || 'Failed to create block');
      }
    } catch (err) { alert(err.message); }
  });

  async function deleteBlock(id) {
    if (!confirm('Release this maintenance block and restore availability?')) return;
    try {
      await fetch(`/api/v1/admin/maintenance/${id}`, { method: 'DELETE' });
      loadMaintenance();
    } catch (e) { alert(e.message); }
  }

  document.addEventListener('DOMContentLoaded', init);
  </script>

</body>
</html>
