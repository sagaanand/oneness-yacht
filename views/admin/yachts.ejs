<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Fleet Management — Oneness Yachts Operations</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@700&display=swap" rel="stylesheet">
  <style>
    :root {
      --navy: #07111c;
      --gold: #c9a66b;
      --card-bg: #0d1a29;
      --border: rgba(255, 255, 255, 0.08);
      --muted: #71808c;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      background: #060e18;
      color: #e2e8f0;
      font-family: 'Inter', sans-serif;
      min-height: 100vh;
    }
    .admin-container {
      max-width: 1440px;
      margin: 0 auto;
      padding: 32px 24px;
    }
    .page-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 28px;
      flex-wrap: wrap;
      gap: 16px;
    }
    .kicker {
      font-size: 11px;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: var(--gold);
      font-weight: 700;
      margin-bottom: 4px;
    }
    .page-title {
      font-family: Georgia, serif;
      font-size: 32px;
      color: #fff;
    }
    .btn-gold {
      background: linear-gradient(135deg, #c9a66b, #9a7633);
      color: #040912;
      font-weight: 700;
      padding: 10px 18px;
      border-radius: 8px;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: 13px;
      border: none;
      cursor: pointer;
    }
    .fleet-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 24px;
    }
    .yacht-card {
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 14px;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      transition: transform 0.2s, border-color 0.2s;
    }
    .yacht-card:hover {
      transform: translateY(-2px);
      border-color: rgba(201,166,107,0.3);
    }
    .yacht-img {
      width: 100%;
      height: 180px;
      object-fit: cover;
      background: #071220;
    }
    .yacht-body {
      padding: 20px;
      flex: 1;
      display: flex;
      flex-direction: column;
    }
    .yacht-title {
      font-family: Georgia, serif;
      font-size: 20px;
      color: #fff;
      margin-bottom: 6px;
    }
    .yacht-specs {
      display: flex;
      gap: 14px;
      font-size: 12px;
      color: var(--muted);
      margin-bottom: 14px;
    }
    .price-tag {
      font-size: 18px;
      font-weight: 700;
      color: var(--gold);
      margin-bottom: 14px;
    }
    .badge {
      display: inline-block;
      padding: 4px 8px;
      border-radius: 4px;
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
    }
    .badge-active { background: rgba(16,185,129,0.15); color: #34d399; }
    .badge-inactive { background: rgba(239,68,68,0.15); color: #f87171; }
    .card-actions {
      display: flex;
      gap: 8px;
      margin-top: auto;
      padding-top: 14px;
      border-top: 1px solid rgba(255,255,255,0.06);
    }
    .btn-sm-action {
      flex: 1;
      background: rgba(255,255,255,0.06);
      border: 1px solid rgba(255,255,255,0.12);
      color: #e2e8f0;
      padding: 8px 10px;
      border-radius: 6px;
      font-size: 12px;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 4px;
      cursor: pointer;
    }
    .btn-sm-action:hover {
      border-color: var(--gold);
      color: var(--gold);
    }
  </style>
</head>
<body>

  <%- include('nav-header', { activeTab: 'yachts', adminUser: adminUser }) %>

  <div class="admin-container">
    <div class="page-header">
      <div>
        <div class="kicker">Fleet Directory & Capacity</div>
        <h1 class="page-title">Yachts Management</h1>
      </div>
      <div>
        <a href="/admin/yachts/new" class="btn-gold">
          <i class="fa-solid fa-plus"></i> Add New Yacht
        </a>
      </div>
    </div>

    <!-- Fleet Grid -->
    <div class="fleet-grid" id="fleetGrid">
      <div style="grid-column: 1 / -1; text-align: center; padding: 60px; color: var(--muted);">
        <i class="fa-solid fa-spinner fa-spin" style="font-size: 28px; color: var(--gold); margin-bottom: 12px;"></i>
        <p>Loading fleet vessels...</p>
      </div>
    </div>
  </div>

  <script>
  async function loadFleet() {
    try {
      const res = await fetch('/api/v1/yachts');
      const data = await res.json();
      if (data.success) {
        renderFleet(data.yachts);
      }
    } catch (e) {
      console.error('Failed to load fleet:', e);
    }
  }

  function renderFleet(yachts) {
    const grid = document.getElementById('fleetGrid');
    if (!yachts || yachts.length === 0) {
      grid.innerHTML = '<div style="grid-column: 1 / -1; text-align: center; padding: 40px;">No vessels found.</div>';
      return;
    }

    grid.innerHTML = yachts.map(y => {
      const img = (y.images && y.images[0]) || y.image || '/assets/images/home/01.jpg';
      const rate = y.base_hourly_rate || y.numericPrice || 0;
      return `
        <div class="yacht-card">
          <img src="${img}" alt="${y.title}" class="yacht-img">
          <div class="yacht-body">
            <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 6px;">
              <h3 class="yacht-title">${y.title}</h3>
              <span class="badge badge-active">${y.booking_mode || 'INSTANT'}</span>
            </div>
            <div class="yacht-specs">
              <span><i class="fa-solid fa-ruler-horizontal"></i> ${y.length_ft || y.lengthFt || 50} FT</span>
              <span><i class="fa-solid fa-users"></i> ${y.capacity_day || y.capacity || 15} PAX</span>
              <span><i class="fa-solid fa-anchor"></i> ${y.marina || 'Dubai Marina'}</span>
            </div>
            <div class="price-tag">${parseFloat(rate).toLocaleString()} AED <span style="font-size: 12px; color: var(--muted); font-weight: normal;">/ hour</span></div>
            <div class="card-actions">
              <a href="/admin/yachts/${y.id || y.slug}/edit" class="btn-sm-action">
                <i class="fa-solid fa-pen-to-square"></i> Edit
              </a>
              <a href="/yachts/${y.slug}" target="_blank" class="btn-sm-action">
                <i class="fa-solid fa-arrow-up-right-from-square"></i> Live Page
              </a>
              <button onclick="toggleYachtStatus('${y.id || y.slug}')" class="btn-sm-action" style="color: #f87171;">
                <i class="fa-solid fa-power-off"></i>
              </button>
            </div>
          </div>
        </div>
      `;
    }).join('');
  }

  async function toggleYachtStatus(id) {
    if (!confirm('Toggle vessel operational active status?')) return;
    try {
      await fetch(`/api/v1/admin/yachts/${id}`, {
        method: 'DELETE'
      });
      alert('Vessel status updated.');
      loadFleet();
    } catch (e) { alert(e.message); }
  }

  document.addEventListener('DOMContentLoaded', loadFleet);
  </script>

</body>
</html>
