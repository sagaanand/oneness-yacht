<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Add-on Services & Experiences — Oneness Yachts Operations</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@700&display=swap" rel="stylesheet">
  <style>
    :root {
      --navy: #07111c;
      --gold: #c9a66b;
      --card-bg: #0d1a29;
      --border: rgba(255, 255, 255, 0.08);
      --muted: #71808c;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      background: #060e18;
      color: #e2e8f0;
      font-family: 'Inter', sans-serif;
      min-height: 100vh;
    }
    .admin-container {
      max-width: 1440px;
      margin: 0 auto;
      padding: 32px 24px;
    }
    .page-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 28px;
      flex-wrap: wrap;
      gap: 16px;
    }
    .kicker {
      font-size: 11px;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: var(--gold);
      font-weight: 700;
      margin-bottom: 4px;
    }
    .page-title {
      font-family: Georgia, serif;
      font-size: 32px;
      color: #fff;
    }
    .btn-gold {
      background: linear-gradient(135deg, #c9a66b, #9a7633);
      color: #040912;
      font-weight: 700;
      padding: 10px 18px;
      border-radius: 8px;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: 13px;
      border: none;
      cursor: pointer;
    }
    .addons-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 20px;
    }
    .addon-card {
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 24px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }
    .addon-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 12px;
    }
    .addon-icon {
      width: 44px;
      height: 44px;
      border-radius: 10px;
      background: rgba(201,166,107,0.12);
      color: var(--gold);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 20px;
    }
    .addon-price {
      font-size: 20px;
      font-weight: 700;
      color: var(--gold);
      margin: 12px 0 16px;
    }
    .tag {
      display: inline-block;
      font-size: 11px;
      padding: 3px 8px;
      border-radius: 4px;
      background: rgba(255,255,255,0.06);
      color: var(--muted);
      text-transform: uppercase;
      font-weight: 600;
    }
    .btn-action-row {
      display: flex;
      gap: 8px;
      margin-top: 14px;
      padding-top: 14px;
      border-top: 1px solid rgba(255,255,255,0.06);
    }
    .btn-sm {
      flex: 1;
      padding: 8px;
      font-size: 12px;
      border-radius: 6px;
      border: 1px solid rgba(255,255,255,0.1);
      background: rgba(255,255,255,0.04);
      color: #e2e8f0;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 4px;
    }
    .btn-sm:hover {
      border-color: var(--gold);
      color: var(--gold);
    }
    /* Modal */
    .modal-overlay {
      position: fixed;
      top: 0; left: 0; right: 0; bottom: 0;
      background: rgba(0,0,0,0.8);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 9999;
      padding: 20px;
    }
    .modal-content {
      max-width: 520px;
      width: 100%;
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 28px;
    }
    .form-group { margin-bottom: 16px; }
    .label { display: block; font-size: 12px; color: var(--muted); margin-bottom: 6px; text-transform: uppercase; }
    .input, select, textarea {
      width: 100%;
      background: #071220;
      border: 1px solid rgba(255,255,255,0.12);
      border-radius: 6px;
      padding: 10px 12px;
      color: #fff;
      font-size: 13px;
      outline: none;
    }
  </style>
</head>
<body>

  <%- include('nav-header', { activeTab: 'addons', adminUser: adminUser }) %>

  <div class="admin-container">
    <div class="page-header">
      <div>
        <div class="kicker">VIP Experiences & Enhancements</div>
        <h1 class="page-title">Add-on Services Catalog</h1>
      </div>
      <div>
        <button onclick="openModal()" class="btn-gold">
          <i class="fa-solid fa-plus"></i> Create New Add-on
        </button>
      </div>
    </div>

    <!-- Catalog Grid -->
    <div class="addons-grid" id="addonsGrid">
      <div style="grid-column: 1 / -1; text-align: center; padding: 60px; color: var(--muted);">
        <i class="fa-solid fa-spinner fa-spin" style="font-size: 28px; color: var(--gold); margin-bottom: 12px;"></i>
        <p>Loading add-on catalog...</p>
      </div>
    </div>
  </div>

  <!-- Create/Edit Modal -->
  <div class="modal-overlay" id="addonModal">
    <div class="modal-content">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
        <h3 style="font-family: Georgia, serif; font-size: 20px; color: #fff;" id="modalTitle">Create Add-on</h3>
        <button onclick="closeModal()" style="background: none; border: none; color: var(--muted); font-size: 18px; cursor: pointer;">&times;</button>
      </div>

      <form id="addonForm">
        <input type="hidden" id="addonId">
        <div class="form-group">
          <label class="label">Experience Name</label>
          <input type="text" id="addonName" class="input" placeholder="e.g. Jet Ski Seadoo 300HP" required>
        </div>

        <div class="form-group">
          <label class="label">Category</label>
          <select id="addonCategory">
            <option value="WATERSPORTS">WATERSPORTS</option>
            <option value="CATERING">CATERING & DINING</option>
            <option value="ENTERTAINMENT">ENTERTAINMENT & MEDIA</option>
            <option value="DECORATION">FLORAL & DECOR</option>
            <option value="VIP_TRANSFERS">VIP TRANSFERS</option>
          </select>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
          <div class="form-group">
            <label class="label">Price (AED)</label>
            <input type="number" id="addonPrice" class="input" placeholder="950" required>
          </div>
          <div class="form-group">
            <label class="label">Pricing Model</label>
            <select id="addonPricingType">
              <option value="FIXED">FIXED (Per Charter)</option>
              <option value="HOURLY">HOURLY (Per Hour)</option>
              <option value="PER_PERSON">PER PERSON (Per Guest)</option>
            </select>
          </div>
        </div>

        <div class="form-group">
          <label class="label">Icon (FontAwesome)</label>
          <input type="text" id="addonIcon" class="input" placeholder="fa-solid fa-water">
        </div>

        <div class="form-group">
          <label class="label">Description</label>
          <textarea id="addonDesc" rows="3" placeholder="Description of service inclusions, safety instructions, or duration limits..."></textarea>
        </div>

        <div style="display: flex; gap: 10px; margin-top: 20px;">
          <button type="submit" class="btn-gold" style="flex: 1; justify-content: center;">Save Experience</button>
          <button type="button" onclick="closeModal()" class="btn-sm" style="flex: 1;">Cancel</button>
        </div>
      </form>
    </div>
  </div>

  <script>
  let addons = [];

  async function loadAddons() {
    try {
      const res = await fetch('/api/v1/addons');
      const data = await res.json();
      if (data.success) {
        addons = data.addons;
        renderAddons(addons);
      }
    } catch (e) { console.error(e); }
  }

  function renderAddons(list) {
    const grid = document.getElementById('addonsGrid');
    if (!list || list.length === 0) {
      grid.innerHTML = '<div style="grid-column: 1 / -1; text-align: center; padding: 40px;">No add-on services found.</div>';
      return;
    }

    grid.innerHTML = list.map(a => {
      const icon = a.icon || 'fa-solid fa-star';
      const pricingLabel = a.pricing_type === 'HOURLY' ? '/ hour' :
                           a.pricing_type === 'PER_PERSON' ? '/ guest' : 'flat fee';

      return `
        <div class="addon-card">
          <div>
            <div class="addon-header">
              <div class="addon-icon"><i class="${icon}"></i></div>
              <span class="tag">${a.category || 'SERVICE'}</span>
            </div>
            <h3 style="font-size: 18px; color: #fff; margin-bottom: 6px;">${a.name}</h3>
            <p style="font-size: 13px; color: var(--muted); line-height: 1.5;">${a.description || 'Luxury add-on enhancement for private charter guests.'}</p>
          </div>
          <div>
            <div class="addon-price">
              ${parseFloat(a.price).toLocaleString()} AED <span style="font-size: 12px; color: var(--muted); font-weight: normal;">${pricingLabel}</span>
            </div>
            <div class="btn-action-row">
              <button onclick="editAddon('${a.id}')" class="btn-sm"><i class="fa-solid fa-pen"></i> Edit</button>
              <button onclick="toggleAddon('${a.id}')" class="btn-sm" style="color: #f87171;"><i class="fa-solid fa-trash"></i> Disable</button>
            </div>
          </div>
        </div>
      `;
    }).join('');
  }

  function openModal(id = null) {
    document.getElementById('addonModal').style.display = 'flex';
    if (!id) {
      document.getElementById('modalTitle').textContent = 'Create New Add-on Experience';
      document.getElementById('addonId').value = '';
      document.getElementById('addonName').value = '';
      document.getElementById('addonPrice').value = '';
      document.getElementById('addonIcon').value = 'fa-solid fa-star';
      document.getElementById('addonDesc').value = '';
    }
  }

  function closeModal() {
    document.getElementById('addonModal').style.display = 'none';
  }

  function editAddon(id) {
    const item = addons.find(a => a.id === id);
    if (!item) return;
    openModal(id);
    document.getElementById('modalTitle').textContent = 'Edit Add-on Experience';
    document.getElementById('addonId').value = item.id;
    document.getElementById('addonName').value = item.name;
    document.getElementById('addonPrice').value = item.price;
    document.getElementById('addonCategory').value = item.category || 'WATERSPORTS';
    document.getElementById('addonPricingType').value = item.pricing_type || 'FIXED';
    document.getElementById('addonIcon').value = item.icon || 'fa-solid fa-star';
    document.getElementById('addonDesc').value = item.description || '';
  }

  document.getElementById('addonForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const id = document.getElementById('addonId').value;
    const payload = {
      name: document.getElementById('addonName').value,
      price: parseFloat(document.getElementById('addonPrice').value),
      category: document.getElementById('addonCategory').value,
      pricing_type: document.getElementById('addonPricingType').value,
      icon: document.getElementById('addonIcon').value,
      description: document.getElementById('addonDesc').value
    };

    try {
      const url = id ? `/api/v1/admin/addons/${id}` : '/api/v1/admin/addons';
      const method = id ? 'PUT' : 'POST';
      const res = await fetch(url, {
        method,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const data = await res.json();
      if (data.success) {
        closeModal();
        loadAddons();
      } else {
        alert(data.error || 'Failed to save add-on');
      }
    } catch (err) { alert(err.message); }
  });

  async function toggleAddon(id) {
    if (!confirm('Disable this add-on from customer booking wizard?')) return;
    try {
      await fetch(`/api/v1/admin/addons/${id}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ active: false })
      });
      loadAddons();
    } catch (e) { alert(e.message); }
  }

  document.addEventListener('DOMContentLoaded', loadAddons);
  </script>

</body>
</html>
