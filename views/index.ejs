<style>
/* Mobile Menu */
.mobile-menu { position: fixed; inset: 0; z-index: 300; display: none; }
.mobile-menu[hidden] { display: none !important; }
.mobile-menu.open { display: block; }
.mobile-menu-overlay { position: absolute; inset: 0; background: rgba(7,15,28,0.7); }
.mobile-menu-panel {
  position: absolute;
  top: 0; right: 0;
  width: min(360px, 90vw);
  height: 100%;
  background: var(--navy-900);
  padding: 28px;
  display: flex;
  flex-direction: column;
  animation: slideInRight 0.3s var(--ease-out);
}
@keyframes slideInRight {
  from { transform: translateX(100%); }
  to { transform: translateX(0); }
}
.mobile-menu-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 48px; }
.mobile-menu-close {
  width: 36px; height: 36px;
  display: flex; align-items: center; justify-content: center;
  border-radius: 50%; background: rgba(255,255,255,0.1);
  color: var(--white); font-size: 18px;
}
.mobile-nav { flex: 1; }
.mobile-nav a {
  display: block;
  font-family: var(--font-serif);
  font-size: 24px;
  font-weight: 300;
  color: rgba(255,255,255,0.8);
  padding: 16px 0;
  border-bottom: 1px solid rgba(255,255,255,0.07);
  transition: color var(--transition);
}
.mobile-nav a:hover { color: var(--gold); }
.mobile-menu-footer { margin-top: 32px; }

/* Pillars */
.pillars-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 40px;
}
.pillar-card {
  text-align: center;
  padding: 40px 28px;
  border: 1px solid rgba(255,255,255,0.06);
  border-radius: var(--radius-lg);
  background: rgba(255,255,255,0.03);
  transition: background var(--transition);
}
.pillar-card:hover { background: rgba(255,255,255,0.06); }
.pillar-icon {
  font-size: 32px;
  color: var(--gold);
  margin-bottom: 20px;
}
.pillar-title {
  font-family: var(--font-serif);
  font-size: 22px;
  font-weight: 400;
  color: var(--white);
  margin-bottom: 12px;
}
.pillar-desc {
  font-size: 14px;
  color: rgba(255,255,255,0.55);
  line-height: 1.7;
}

/* Experiences Grid */
.experiences-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
}
.exp-card {
  position: relative;
  aspect-ratio: 3/4;
  border-radius: var(--radius-lg);
  overflow: hidden;
  background: var(--navy-800);
  background-size: cover;
  background-position: center;
  display: flex;
  align-items: flex-end;
  cursor: pointer;
  transition: transform var(--transition);
}
.exp-card:hover { transform: scale(1.02); }
.exp-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(7,15,28,0.85) 0%, rgba(7,15,28,0.1) 60%);
}
.exp-content {
  position: relative;
  z-index: 1;
  padding: 24px;
}
.exp-title {
  font-family: var(--font-serif);
  font-size: 22px;
  font-weight: 400;
  color: var(--white);
  margin-bottom: 6px;
}
.exp-sub {
  font-size: 13px;
  color: rgba(255,255,255,0.65);
  margin-bottom: 16px;
}

/* Quick Book Strip */
.quick-book-strip {
  background: linear-gradient(135deg, var(--navy-900) 0%, var(--navy-700) 100%);
  padding: 80px 0;
  border-top: 1px solid rgba(201,166,107,0.2);
  border-bottom: 1px solid rgba(201,166,107,0.2);
}
.quick-book-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 32px;
}

/* Yacht card skeletons */
.yacht-card-skeleton {
  height: 440px;
  border-radius: var(--radius-lg);
  background: linear-gradient(90deg, #e8ecef 25%, #f0f3f5 50%, #e8ecef 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
}
@keyframes shimmer {
  0% { background-position: -200% 0; }
  100% { background-position: 200% 0; }
}

@media (max-width: 900px) {
  .pillars-grid, .experiences-grid { grid-template-columns: 1fr; gap: 20px; }
  .quick-book-inner { flex-direction: column; text-align: center; }
  .exp-card { aspect-ratio: 16/9; }
}
@media (max-width: 640px) {
  .quick-book-inner .btn { width: 100%; justify-content: center; }
}
</style>

<script>
// ============================================================
// HEADER SCROLL BEHAVIOR
// ============================================================
const header = document.getElementById('siteHeader');
window.addEventListener('scroll', () => {
  if (window.scrollY > 60) {
    header.classList.remove('transparent');
    header.classList.add('scrolled');
  } else {
    header.classList.remove('scrolled');
    header.classList.add('transparent');
  }
}, { passive: true });

// ============================================================
// MOBILE MENU
// ============================================================
const mobileMenu = document.getElementById('mobileMenu');
const mobileMenuBtn = document.getElementById('mobileMenuBtn');
const mobileMenuClose = document.getElementById('mobileMenuClose');
const mobileMenuOverlay = document.getElementById('mobileMenuOverlay');

function openMobileMenu() {
  mobileMenu.hidden = false;
  mobileMenu.classList.add('open');
  mobileMenuBtn.setAttribute('aria-expanded', 'true');
  document.body.style.overflow = 'hidden';
}

function closeMobileMenu() {
  mobileMenu.hidden = true;
  mobileMenu.classList.remove('open');
  mobileMenuBtn.setAttribute('aria-expanded', 'false');
  document.body.style.overflow = '';
}

mobileMenuBtn.addEventListener('click', openMobileMenu);
mobileMenuClose.addEventListener('click', closeMobileMenu);
mobileMenuOverlay.addEventListener('click', closeMobileMenu);

// ============================================================
// SCROLL REVEAL
// ============================================================
const revealObserver = new IntersectionObserver((entries) => {
  entries.forEach(entry => {
    if (entry.isIntersecting) {
      entry.target.classList.add('visible');
      revealObserver.unobserve(entry.target);
    }
  });
}, { threshold: 0.1 });

document.querySelectorAll('.reveal').forEach(el => revealObserver.observe(el));

// ============================================================
// LOAD FLEET FROM API
// ============================================================
async function loadFleet() {
  const grid = document.getElementById('fleetGrid');
  try {
    const res = await fetch('/api/v1/yachts');
    const data = await res.json();
    if (!data.success || !data.yachts.length) {
      grid.innerHTML = '<div class="empty-state"><div class="empty-state-icon"><i class="fa-solid fa-anchor"></i></div><div class="empty-state-title">Fleet Coming Soon</div></div>';
      return;
    }

    const featured = data.yachts.slice(0, 6);
    grid.innerHTML = featured.map(y => {
      const images = Array.isArray(y.images_json) ? y.images_json : [];
      const img = images[0] || '/assets/images/home/01.jpg';
      const price = Number(y.base_hourly_rate || 0).toLocaleString();
      const isInstant = y.booking_mode !== 'CONCIERGE_QUOTE';
      return `
        <article class="yacht-card" data-slug="${y.slug}">
          <div class="yacht-card__image">
            <img
              src="${img}"
              alt="${y.title} — ${y.length_ft}ft yacht Dubai"
              loading="lazy"
              onerror="this.src='/assets/images/home/01.jpg'"
            >
            ${isInstant ? '<div class="yacht-card__badge">Instant Book</div>' : '<div class="yacht-card__badge" style="background:var(--navy-700);color:var(--gold)">By Request</div>'}
          </div>
          <div class="yacht-card__body">
            <h3 class="yacht-card__name">${y.title}</h3>
            <div class="yacht-card__specs">
              <div class="spec-item"><i class="fa-solid fa-ruler-horizontal"></i> ${y.length_ft} FT</div>
              <div class="spec-item"><i class="fa-solid fa-users"></i> ${y.capacity_day} Guests</div>
              ${y.cabins ? `<div class="spec-item"><i class="fa-solid fa-door-open"></i> ${y.cabins} Cabins</div>` : ''}
            </div>
            <div class="yacht-card__price">
              AED ${price} <span>/ hour</span>
            </div>
            <div class="yacht-card__actions">
              <a href="/yachts/${y.slug}" class="btn btn-outline-dark btn-sm">Details</a>
              <a href="/book?yacht=${y.slug}" class="btn btn-primary btn-sm">Book Now</a>
            </div>
          </div>
        </article>
      `;
    }).join('');
  } catch (err) {
    console.warn('Fleet load failed, showing JSON data yachts');
    loadFleetFromJSON();
  }
}

// Fallback to JSON data yachts
async function loadFleetFromJSON() {
  const grid = document.getElementById('fleetGrid');
  try {
    const res = await fetch('/api/yachts');
    const data = await res.json();
    if (!data.yachts || !data.yachts.length) {
      grid.innerHTML = '';
      return;
    }
    const featured = data.yachts.filter(y => y.numericPrice > 0).slice(0, 6);
    grid.innerHTML = featured.map(y => {
      const price = Number(y.numericPrice || 0).toLocaleString();
      const img = y.image || '/assets/images/home/01.jpg';
      return `
        <article class="yacht-card">
          <div class="yacht-card__image">
            <img src="${img}" alt="${y.title}" loading="lazy" onerror="this.src='/assets/images/home/01.jpg'">
            <div class="yacht-card__badge">Book Now</div>
          </div>
          <div class="yacht-card__body">
            <h3 class="yacht-card__name">${y.title}</h3>
            <div class="yacht-card__specs">
              <div class="spec-item"><i class="fa-solid fa-ruler-horizontal"></i> ${y.lengthFt} FT</div>
              <div class="spec-item"><i class="fa-solid fa-users"></i> ${y.capacity} Guests</div>
            </div>
            <div class="yacht-card__price">AED ${price} <span>/ hour</span></div>
            <div class="yacht-card__actions">
              <a href="/yacht/${y.slug}" class="btn btn-outline-dark btn-sm">Details</a>
              <a href="/booking?yacht=${y.slug}" class="btn btn-primary btn-sm">Book</a>
            </div>
          </div>
        </article>
      `;
    }).join('');
  } catch (err) {
    grid.innerHTML = '<div class="empty-state"><div class="empty-state-icon"><i class="fa-solid fa-anchor"></i></div></div>';
  }
}

// ============================================================
// CHECK CUSTOMER SESSION
// ============================================================
async function checkSession() {
  try {
    const res = await fetch('/api/v1/auth/me');
    const data = await res.json();
    if (data.success && data.customer) {
      document.getElementById('headerLoginLabel').textContent = data.customer.name.split(' ')[0];
      document.getElementById('headerLoginBtn').href = '/account';
    }
  } catch {}
}

// ============================================================
// TOAST HELPER
// ============================================================
window.showToast = function(msg, type = 'info') {
  const container = document.getElementById('toastContainer');
  const icons = { success: 'fa-circle-check', error: 'fa-circle-xmark', info: 'fa-circle-info' };
  const toast = document.createElement('div');
  toast.className = `toast toast--${type}`;
  toast.innerHTML = `<i class="fa-solid ${icons[type] || icons.info} toast-icon"></i><span class="toast-msg">${msg}</span>`;
  container.appendChild(toast);
  setTimeout(() => { toast.style.opacity = '0'; toast.style.transform = 'translateY(8px)'; toast.style.transition = '0.3s'; setTimeout(() => toast.remove(), 300); }, 4000);
};

// Init
loadFleet();
checkSession();
</script>
</body>
</html>
