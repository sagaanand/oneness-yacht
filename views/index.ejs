<!-- 06 — PRIVATE CHARTER REQUEST (CONVERSION HUB) -->
<section class="section section-spacious charter-inquiry-section" id="charter-inquiry">
  <div class="container">
    <div style="text-align: center; max-width: 680px; margin: 0 auto 50px;">
      <div class="eyebrow" style="justify-content: center;">Private Booking</div>
      <h2 class="editorial-title" style="margin-bottom: 16px;">Plan Your Private Charter</h2>
      <p class="editorial-subhead" style="margin: 0 auto;">
        Our charter team will contact you shortly to curate your experience.
      </p>
    </div>

    <div class="charter-form-wrapper">
      <form class="inquiry-form" id="homeInquiryForm">
        <!-- Status Feedback Alert Box -->
        <div class="form-alert-box" id="formAlertBox"></div>

        <div class="form-grid-two">
          <div class="form-field">
            <label class="form-label" for="inqName">Full Name *</label>
            <input type="text" id="inqName" name="name" class="form-input" placeholder="e.g. Lord Alexander Wright" required>
          </div>

          <div class="form-field">
            <label class="form-label" for="inqPhone">Phone Number *</label>
            <input type="tel" id="inqPhone" name="phone" class="form-input" placeholder="+971 50 000 0000" required>
          </div>
        </div>

        <div class="form-grid-two">
          <div class="form-field">
            <label class="form-label" for="inqEmail">Email Address</label>
            <input type="email" id="inqEmail" name="email" class="form-input" placeholder="alexander@domain.com">
          </div>

          <div class="form-field">
            <label class="form-label" for="inqDate">Preferred Date</label>
            <input type="date" id="inqDate" name="date" class="form-input">
          </div>
        </div>

        <div class="form-grid-two">
          <div class="form-field">
            <label class="form-label" for="inqGuests">Guest Count</label>
            <select id="inqGuests" name="guests" class="form-select">
              <option value="2-6 Guests">Intimate (2 – 6 Guests)</option>
              <option value="7-15 Guests" selected>Private Party (7 – 15 Guests)</option>
              <option value="16-30 Guests">Celebration (16 – 30 Guests)</option>
              <option value="30+ Guests">Mega Gala (30 – 50+ Guests)</option>
            </select>
          </div>

          <div class="form-field">
            <label class="form-label" for="inqYacht">Preferred Vessel</label>
            <select id="inqYacht" name="yacht" class="form-select">
              <option value="Not Decided / Recommend Best">Recommend Best Vessel for My Party</option>
              <% yachts.slice(0, 15).forEach(y => { %>
                <option value="<%= y.title %> (<%= y.lengthFt %> FT)"><%= y.title %> — <%= y.lengthFt %> FT (<%= y.category %>)</option>
              <% }); %>
            </select>
          </div>
        </div>

        <div class="form-field">
          <label class="form-label" for="inqNotes">Private Notes & Special Requirements</label>
          <textarea id="inqNotes" name="notes" class="form-textarea" placeholder="Specify catering preferences, dietary requirements, champagne selections, or bespoke event themes..."></textarea>
        </div>

        <div style="text-align: center; margin-top: 10px;">
          <button type="submit" class="btn-primary" style="min-width: 280px;">
            Request Your Charter &rarr;
          </button>
          <div style="font-size: 0.76rem; color: var(--text-tertiary); margin-top: 16px; letter-spacing: 0.05em;">
            Confidential &bull; Zero spam &bull; Direct response within 15 minutes
          </div>
        </div>
      </form>
    </div>
  </div>
</section>

