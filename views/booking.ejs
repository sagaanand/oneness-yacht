<%- include('partials/footer') %>
<%- include('partials/scripts') %>

<script>
  // State variables
  let currentDuration = 3;
  let currentCurrency = 'AED';
  const currencyRates = {
    AED: { symbol: 'AED', rate: 1 },
    USD: { symbol: '$', rate: 0.272 },
    EUR: { symbol: '€', rate: 0.25 }
  };

  // Selected yacht state
  let selectedYacht = {
    slug: '',
    title: '',
    length: '',
    capacity: 20,
    pricePerHour: 5000,
    priceStr: '5,000 AED',
    image: '/assets/images/home/01.jpg'
  };

  // Set default date to tomorrow
  document.addEventListener('DOMContentLoaded', () => {
    const dateInput = document.getElementById('bookingDate');
    const tomorrow = new Date();
    tomorrow.setDate(tomorrow.getDate() + 1);
    const yyyy = tomorrow.getFullYear();
    const mm = String(tomorrow.getMonth() + 1).padStart(2, '0');
    const dd = String(tomorrow.getDate()).padStart(2, '0');
    dateInput.min = `${yyyy}-${mm}-${dd}`;
    dateInput.value = `${yyyy}-${mm}-${dd}`;

    // Select initial active yacht
    const selectedEl = document.querySelector('.yachtCardItem.selected') || document.querySelector('.yachtCardItem');
    if (selectedEl) {
      selectYacht(selectedEl);
    } else {
      updateSummary();
    }
  });

  let currentStep = 1;

  // Step Wizard Navigation
  function goToStep(step) {
    if (step < 1 || step > 4) return;

    // Validation when leaving Step 1 (Fleet & Charter Params)
    if (step > 1) {
      const date = document.getElementById('bookingDate').value;
      if (!date) {
        alert('Please select your charter date first.');
        goToStep(1);
        document.getElementById('bookingDate').focus();
        return;
      }
      if (!selectedYacht.title) {
        alert('Please select a yacht from our luxury fleet.');
        goToStep(1);
        return;
      }
    }

    // Validation when going to Step 4 (Instant Quote & Confirmation)
    if (step === 4) {
      const guestName = document.getElementById('guestName').value.trim();
      const guestPhone = document.getElementById('guestPhone').value.trim();
      if (!guestName) {
        alert('Please enter your full name before reviewing the instant quote.');
        goToStep(3);
        document.getElementById('guestName').focus();
        return;
      }
      if (!guestPhone) {
        alert('Please enter your WhatsApp / mobile phone number.');
        goToStep(3);
        document.getElementById('guestPhone').focus();
        return;
      }
    }

    currentStep = step;

    // Update pill tabs active state
    document.querySelectorAll('.wizardProgress .stepItem').forEach(item => {
      const s = parseInt(item.getAttribute('data-step'), 10);
      if (s === step) {
        item.classList.add('active');
      } else {
        item.classList.remove('active');
      }
    });

    // Toggle step containers
    for (let i = 1; i <= 4; i++) {
      const view = document.getElementById('stepView' + i);
      if (view) {
        view.style.display = (i === step) ? 'block' : 'none';
      }
    }

    // When entering Step 4, populate the comprehensive quote and initiate 15m server hold
    if (step === 4) {
      renderStep4Quote();
      ensureServerHold();
    }

    // Smooth scroll to top of wizard engine
    const layout = document.querySelector('.bookingContainer');
    if (layout) {
      const headerOffset = 80;
      const elementPosition = layout.getBoundingClientRect().top;
      const offsetPosition = elementPosition + window.pageYOffset - headerOffset;
      window.scrollTo({ top: offsetPosition, behavior: 'smooth' });
    }
  }

  // Render Step 4 itemized quotation & review data
  function renderStep4Quote() {
    const dest = document.getElementById('bookingDestination').value;
    const date = document.getElementById('bookingDate').value;
    const slot = document.getElementById('bookingTimeSlot').value;
    const pax = parseInt(document.getElementById('bookingGuests').value, 10) || 1;
    const guestName = document.getElementById('guestName').value.trim() || 'Lead Charter Guest';
    const guestPhone = document.getElementById('guestPhone').value.trim() || 'Not specified';
    const guestEmail = document.getElementById('guestEmail').value.trim() || 'Not specified';
    const guestOccasion = document.getElementById('guestOccasion').value;
    const guestNotes = document.getElementById('guestNotes').value.trim() || 'Standard luxury VIP charter setup';

    // Vessel & Itinerary Details
    const yachtTitleEl = document.getElementById('step4YachtTitle');
    if (yachtTitleEl) yachtTitleEl.textContent = selectedYacht.title;
    const yachtImgEl = document.getElementById('step4YachtImg');
    if (yachtImgEl) yachtImgEl.src = selectedYacht.image;
    const yachtSpecsEl = document.getElementById('step4YachtSpecs');
    if (yachtSpecsEl) yachtSpecsEl.textContent = `Length: ${selectedYacht.length} ft • Up to ${selectedYacht.capacity} Guests`;
    const itineraryEl = document.getElementById('step4Itinerary');
    if (itineraryEl) itineraryEl.textContent = `${dest.includes('Dubai') ? 'Dubai Marina & Palm Jumeirah' : 'Miami Biscayne Bay'} • ${date} • ${slot.split('(')[0].trim()}`;
    const durationEl = document.getElementById('step4Duration');
    if (durationEl) durationEl.textContent = `${currentDuration} Hours`;
    const paxEl = document.getElementById('step4Pax');
    if (paxEl) paxEl.textContent = `${pax} Guests`;

    // Pricing calculation
    const baseCharterAED = selectedYacht.pricePerHour * currentDuration;
    const rateHourEl = document.getElementById('step4RateHour');
    if (rateHourEl) rateHourEl.textContent = `${formatMoney(selectedYacht.pricePerHour)} / hr`;
    const baseCostEl = document.getElementById('step4BaseCost');
    if (baseCostEl) baseCostEl.textContent = formatMoney(baseCharterAED);

    // Selected VIP Addons
    let addonsTotalAED = 0;
    const addonsListContainer = document.getElementById('step4AddonsList');
    if (addonsListContainer) {
      addonsListContainer.innerHTML = '';
      const checkedAddons = document.querySelectorAll('.addonCheckbox:checked');
      if (checkedAddons.length > 0) {
        checkedAddons.forEach(cb => {
          const name = cb.getAttribute('data-name');
          const price = parseFloat(cb.getAttribute('data-price')) || 0;
          const per = cb.getAttribute('data-per');
          const cost = (per === 'pax') ? (price * pax) : price;
          addonsTotalAED += cost;

          const row = document.createElement('div');
          row.className = 'quoteItemRow';
          row.innerHTML = `<span><i class="fa-solid fa-check" style="color: var(--gold); margin-right: 6px;"></i> ${name}</span><strong>+${formatMoney(cost)}</strong>`;
          addonsListContainer.appendChild(row);
        });
      } else {
        addonsListContainer.innerHTML = '<div class="quoteItemRow" style="color: #94a3b8; font-style: italic;"><span>No VIP add-ons selected</span><strong>0 AED</strong></div>';
      }
    }

    const subtotalAED = baseCharterAED + addonsTotalAED;
    const vatAED = Math.round(subtotalAED * 0.05);
    const grandTotalAED = subtotalAED + vatAED;

    const subtotalEl = document.getElementById('step4Subtotal');
    if (subtotalEl) subtotalEl.textContent = formatMoney(subtotalAED);
    const vatEl = document.getElementById('step4Vat');
    if (vatEl) vatEl.textContent = formatMoney(vatAED);
    const grandTotalEl = document.getElementById('step4GrandTotal');
    if (grandTotalEl) grandTotalEl.textContent = formatMoney(grandTotalAED);

    // Primary Guest Details
    const gNameEl = document.getElementById('step4GuestName');
    if (gNameEl) gNameEl.textContent = guestName;
    const gPhoneEl = document.getElementById('step4GuestPhone');
    if (gPhoneEl) gPhoneEl.textContent = guestPhone;
    const gEmailEl = document.getElementById('step4GuestEmail');
    if (gEmailEl) gEmailEl.textContent = guestEmail;
    const gOccasionEl = document.getElementById('step4Occasion');
    if (gOccasionEl) gOccasionEl.textContent = guestOccasion;
    const gNotesEl = document.getElementById('step4Notes');
    if (gNotesEl) gNotesEl.textContent = guestNotes;
  }

  // Pre-acquire 15-minute server hold when entering Step 4
  async function ensureServerHold() {
    if (activeHoldToken) return;

    const date = document.getElementById('bookingDate').value;
    const slot = document.getElementById('bookingTimeSlot').value;
    const pax = parseInt(document.getElementById('bookingGuests').value, 10) || 1;

    let startHour = 14;
    if (slot.includes('Morning')) startHour = 9;
    else if (slot.includes('Sunset')) startHour = 17;
    else if (slot.includes('Starlight')) startHour = 20;

    const startDate = new Date(`${date}T${String(startHour).padStart(2, '0')}:00:00`);
    const endDate = new Date(startDate.getTime() + currentDuration * 3600000);

    const addonCodes = [];
    document.querySelectorAll('.addonCheckbox:checked').forEach(cb => {
      const code = cb.getAttribute('data-code') || cb.getAttribute('data-name');
      addonCodes.push(code);
    });

    try {
      const holdRes = await fetch('/api/v1/holds', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          yachtId: selectedYacht.slug,
          startTime: startDate.toISOString(),
          endTime: endDate.toISOString(),
          durationHours: currentDuration,
          guests: pax,
          addonCodes
        })
      });
      const holdData = await holdRes.json();
      if (holdData.success) {
        activeHoldToken = holdData.holdToken;
        startHoldCountdown(holdData.remainingSeconds || 900);
      }
    } catch (e) {
      console.warn('Hold pre-acquisition notice:', e.message);
    }
  }

  // Smooth scroll
  function scrollToSection(id) {
    const el = document.getElementById(id);
    if (el) {
      el.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  }

  // Duration pill handler
  function setDuration(hours, btn) {
    currentDuration = hours;
    document.querySelectorAll('#durationPills .pillBtn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    updateSummary();
    if (currentStep === 4) renderStep4Quote();
  }

  // Currency toggle handler
  function setCurrency(curr, btn) {
    currentCurrency = curr;
    document.querySelectorAll('.currBtn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    updateSummary();
    if (currentStep === 4) renderStep4Quote();
  }

  // Yacht selection
  function selectYacht(cardEl) {
    document.querySelectorAll('.yachtCardItem').forEach(c => {
      c.classList.remove('selected');
      const btn = c.querySelector('.selectYachtBtn');
      if (btn) btn.textContent = 'Select';
    });

    cardEl.classList.add('selected');
    const btn = cardEl.querySelector('.selectYachtBtn');
    if (btn) btn.textContent = 'Selected';

    selectedYacht = {
      slug: cardEl.getAttribute('data-slug') || '',
      title: cardEl.getAttribute('data-title') || 'Luxury Yacht',
      length: cardEl.getAttribute('data-length') || '',
      capacity: parseInt(cardEl.getAttribute('data-capacity'), 10) || 20,
      pricePerHour: parseFloat(cardEl.getAttribute('data-price')) || 5000,
      priceStr: cardEl.getAttribute('data-price-str') || '',
      image: cardEl.getAttribute('data-image') || '/assets/images/home/01.jpg'
    };

    // Update Step 1 selected badge
    const badgeName = document.getElementById('step1SelectedName');
    if (badgeName) badgeName.textContent = selectedYacht.title;
    const badgeRate = document.getElementById('step1SelectedRate');
    if (badgeRate) badgeRate.textContent = selectedYacht.priceStr || (selectedYacht.pricePerHour.toLocaleString() + ' AED / hr');

    updateSummary();
    if (currentStep === 4) renderStep4Quote();
  }

  // Add-on item toggle
  function toggleAddon(labelEl) {
    // handled by checkbox change
  }

  // Filter fleet by PAX & category
  function filterCategory(cat, btn) {
    document.querySelectorAll('#categoryPills .pillBtn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    filterFleetAndCalculate(cat);
  }

  function filterFleetAndCalculate(categoryFilter) {
    const pax = parseInt(document.getElementById('bookingGuests').value, 10) || 1;
    const activeCatBtn = document.querySelector('#categoryPills .pillBtn.active');
    const cat = categoryFilter || (activeCatBtn ? activeCatBtn.getAttribute('data-cat') : 'all');

    let visibleCount = 0;
    document.querySelectorAll('.yachtCardItem').forEach(card => {
      const cardCap = parseInt(card.getAttribute('data-capacity'), 10) || 100;
      const cardCat = card.getAttribute('data-category') || 'vip';

      const matchCat = (cat === 'all' || cardCat === cat);
      // Soft filter: show yachts capable of guests, or if pax exceeds, show largest
      const matchPax = (cardCap >= pax || pax <= 10);

      if (matchCat && matchPax) {
        card.style.display = 'flex';
        visibleCount++;
      } else if (matchCat && !matchPax) {
        // still display but dim
        card.style.display = 'flex';
        card.style.opacity = '0.5';
        visibleCount++;
      } else {
        card.style.display = 'none';
      }
    });

    document.getElementById('visibleYachtsCount').textContent = visibleCount;
    updateSummary();
  }

  // Format currency
  function formatMoney(amountAED) {
    const config = currencyRates[currentCurrency] || currencyRates.AED;
    const converted = amountAED * config.rate;
    const formatted = Math.round(converted).toLocaleString('en-US');
    return `${formatted} ${config.symbol}`;
  }

  // Update live calculation & summary
  function updateSummary() {
    const dest = document.getElementById('bookingDestination').value;
    const date = document.getElementById('bookingDate').value;
    const slot = document.getElementById('bookingTimeSlot').value;
    const pax = parseInt(document.getElementById('bookingGuests').value, 10) || 1;

    // Update Right Panel UI
    document.getElementById('summaryDest').textContent = dest.includes('Dubai') ? 'Dubai Marina' : 'Miami, FL';
    document.getElementById('summaryDate').textContent = date || 'Tomorrow';
    document.getElementById('summarySlot').textContent = slot.split('(')[0].trim();
    document.getElementById('summaryHours').textContent = `${currentDuration} Hours`;
    document.getElementById('summaryPax').textContent = `${pax} PAX`;

    document.getElementById('summaryYachtImg').src = selectedYacht.image;
    document.getElementById('summaryYachtTitle').textContent = selectedYacht.title;
    document.getElementById('summaryYachtSpecs').textContent = `Length: ${selectedYacht.length} ft | Max: ${selectedYacht.capacity} PAX`;

    // Pricing calculation
    const baseCharterAED = selectedYacht.pricePerHour * currentDuration;

    // Addons calculation
    let addonsTotalAED = 0;
    const selectedAddonsList = [];
    document.querySelectorAll('.addonCheckbox:checked').forEach(cb => {
      const name = cb.getAttribute('data-name');
      const price = parseFloat(cb.getAttribute('data-price')) || 0;
      const per = cb.getAttribute('data-per');
      const itemCost = (per === 'pax') ? (price * pax) : price;
      addonsTotalAED += itemCost;
      selectedAddonsList.push(`${name} (+${itemCost.toLocaleString()} AED)`);
    });

    const vatAED = Math.round((baseCharterAED + addonsTotalAED) * 0.05);
    const grandTotalAED = baseCharterAED + addonsTotalAED + vatAED;

    // Update prices in summary
    document.getElementById('labelBaseRate').textContent = `Base Charter (${currentDuration}h @ ${selectedYacht.pricePerHour.toLocaleString()} AED/h):`;
    document.getElementById('priceBase').textContent = formatMoney(baseCharterAED);

    const addonsRow = document.getElementById('rowAddons');
    if (addonsTotalAED > 0) {
      addonsRow.style.display = 'flex';
      document.getElementById('priceAddons').textContent = formatMoney(addonsTotalAED);
    } else {
      addonsRow.style.display = 'none';
    }

    document.getElementById('priceVat').textContent = formatMoney(vatAED);
    document.getElementById('priceGrandTotal').textContent = formatMoney(grandTotalAED);

    // Prepare WhatsApp concierge link
    const waText = encodeURIComponent(
      `Hello Oneness Yachts Concierge! 🛥️✨\n` +
      `I would like to reserve a private charter with the following details:\n\n` +
      `• Yacht: ${selectedYacht.title} (${selectedYacht.length} ft)\n` +
      `• Destination: ${dest}\n` +
      `• Date: ${date}\n` +
      `• Time Slot: ${slot}\n` +
      `• Duration: ${currentDuration} Hours\n` +
      `• Guests: ${pax} PAX\n` +
      (selectedAddonsList.length ? `• VIP Add-ons: ${selectedAddonsList.join(', ')}\n` : '') +
      `• Estimated Total: ${grandTotalAED.toLocaleString()} AED\n\n` +
      `Please confirm availability and boarding details.`
    );
    document.getElementById('btnWhatsAppDirect').href = `https://wa.me/971585441134?text=${waText}`;
  }

  let activeHoldToken = null;
  let holdCountdownInterval = null;

  function startHoldCountdown(remainingSecs) {
    let secs = remainingSecs;
    const badge = document.getElementById('holdTimerBadge');
    const banner = document.getElementById('holdCountdownBanner');
    if (banner) banner.style.display = 'block';
    const step4Badge = document.getElementById('step4TimerBadge');

    if (holdCountdownInterval) clearInterval(holdCountdownInterval);

    holdCountdownInterval = setInterval(() => {
      secs--;
      if (secs <= 0) {
        clearInterval(holdCountdownInterval);
        if (badge) {
          badge.textContent = 'EXPIRED';
          badge.style.background = 'rgba(239, 68, 68, 0.3)';
        }
        if (step4Badge) {
          step4Badge.textContent = 'EXPIRED';
          step4Badge.style.background = 'rgba(239, 68, 68, 0.3)';
        }
        alert('Your 15-minute reservation hold has expired. Please refresh availability.');
        return;
      }
      const m = Math.floor(secs / 60);
      const s = secs % 60;
      const timeStr = `${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
      if (badge) badge.textContent = timeStr;
      if (step4Badge) step4Badge.textContent = timeStr;
    }, 1000);
  }

  // Submit booking online with Server-Authoritative 15m Hold & Idempotent Payments
  async function submitBooking() {
    const guestName = document.getElementById('guestName').value.trim();
    const guestPhone = document.getElementById('guestPhone').value.trim();
    const guestEmail = document.getElementById('guestEmail').value.trim();
    const guestOccasion = document.getElementById('guestOccasion').value;
    const guestNotes = document.getElementById('guestNotes').value.trim();

    if (!guestName) {
      alert('Please enter your full name.');
      goToStep(3);
      document.getElementById('guestName').focus();
      return;
    }
    if (!guestPhone) {
      alert('Please enter your WhatsApp / mobile phone number.');
      goToStep(3);
      document.getElementById('guestPhone').focus();
      return;
    }

    const submitBtn = document.getElementById('btnSubmitBooking');
    const submitBtn4 = document.getElementById('btnSubmitBookingStep4');
    const setButtonsLoading = (loadingText) => {
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.innerHTML = `<i class="fa-solid fa-spinner fa-spin"></i> ${loadingText}`;
      }
      if (submitBtn4) {
        submitBtn4.disabled = true;
        submitBtn4.innerHTML = `<i class="fa-solid fa-spinner fa-spin"></i> ${loadingText}`;
      }
    };
    const resetButtons = () => {
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.innerHTML = '<i class="fa-solid fa-shield-halved"></i> Confirm Reservation Online';
      }
      if (submitBtn4) {
        submitBtn4.disabled = false;
        submitBtn4.innerHTML = '<i class="fa-solid fa-shield-halved"></i> Confirm & Secure Charter';
      }
    };

    setButtonsLoading('Securing 15m Yacht Hold...');

    const dest = document.getElementById('bookingDestination').value;
    const date = document.getElementById('bookingDate').value;
    const slot = document.getElementById('bookingTimeSlot').value;
    const pax = parseInt(document.getElementById('bookingGuests').value, 10) || 1;

    // Collect add-on codes
    const addonCodes = [];
    document.querySelectorAll('.addonCheckbox:checked').forEach(cb => {
      const code = cb.getAttribute('data-code') || cb.getAttribute('data-name');
      addonCodes.push(code);
    });

    let startHour = 14;
    if (slot.includes('Morning')) startHour = 9;
    else if (slot.includes('Afternoon')) startHour = 13;
    else if (slot.includes('Sunset')) startHour = 17;
    else if (slot.includes('Starlight')) startHour = 20;

    const startDate = new Date(`${date}T${String(startHour).padStart(2, '0')}:00:00`);
    const endDate = new Date(startDate.getTime() + currentDuration * 3600000);

    try {
      // 1. Acquire Server-Authoritative 15-Minute Hold under Yacht Lock if needed
      if (!activeHoldToken) {
        const holdRes = await fetch('/api/v1/holds', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            yachtId: selectedYacht.slug,
            startTime: startDate.toISOString(),
            endTime: endDate.toISOString(),
            durationHours: currentDuration,
            guests: pax,
            addonCodes
          })
        });

        const holdData = await holdRes.json();
        if (!holdData.success) {
          alert(holdData.error || 'The requested interval is unavailable due to an existing charter or active hold. Please choose another date or time window.');
          resetButtons();
          return;
        }

        activeHoldToken = holdData.holdToken;
        startHoldCountdown(holdData.remainingSeconds || 900);
      }

      setButtonsLoading('Finalizing Charter Booking...');

      // 2. Convert Hold into Booking
      const bookingRes = await fetch('/api/v1/bookings', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          holdToken: activeHoldToken,
          customer: { fullName: guestName, phone: guestPhone, email: guestEmail },
          occasion: guestOccasion,
          specialRequests: guestNotes
        })
      });

      const bookingData = await bookingRes.json();
      if (!bookingData.success) {
        alert(bookingData.error || 'Failed to create charter booking.');
        resetButtons();
        return;
      }

      // 3. Initiate Idempotent Payment
      const idempotencyKey = 'idem_' + Date.now() + '_' + Math.random().toString(36).slice(2, 8);
      await fetch('/api/v1/payments', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Idempotency-Key': idempotencyKey
        },
        body: JSON.stringify({
          bookingId: bookingData.bookingId,
          paymentMethod: 'CARD_ONLINE',
          gateway: 'STRIPE'
        })
      });

      // 4. Present Confirmation Modal with Digital Boarding Pass Link
      document.getElementById('modalVoucherCode').textContent = bookingData.bookingRef;
      document.getElementById('modalYachtName').textContent = `${selectedYacht.title} (${selectedYacht.length} ft)`;
      document.getElementById('modalCharterDate').textContent = `${date} (${dest})`;
      document.getElementById('modalTimeDuration').textContent = `${slot} • ${currentDuration} Hours`;
      document.getElementById('modalGuestName').textContent = `${guestName} (${guestPhone})`;
      document.getElementById('modalGrandTotal').textContent = `${bookingData.pricing.grandTotal.toLocaleString()} AED`;

      // Update boarding pass link
      document.getElementById('modalPassBtn').href = `/my-charter/${bookingData.bookingAccessToken}`;

      // WhatsApp direct
      const modalWaText = encodeURIComponent(
        `Hello! I just confirmed charter booking reference: ${bookingData.bookingRef} for ${selectedYacht.title} on ${date}. Please assist with payment & boarding pass!`
      );
      document.getElementById('modalWhatsAppBtn').href = `https://wa.me/971585441134?text=${modalWaText}`;

      document.getElementById('voucherModal').classList.add('active');
    } catch (err) {
      console.error('Booking submission error:', err);
      alert('An unexpected network error occurred. Please contact Oneness Yachts directly via WhatsApp.');
    } finally {
      resetButtons();
    }
  }

  function closeVoucherModal() {
    document.getElementById('voucherModal').classList.remove('active');
  }
</script>
