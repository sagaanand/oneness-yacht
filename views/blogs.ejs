<%- include('partials/header', { title: 'The Journal | Oneness Luxury Superyachts Dubai', activeNav: 'blogs' }) %>

<!-- JOURNAL HERO -->
<section class="fleet-hero-header">
  <div class="container">
    <div class="eyebrow">The Journal &middot; Perspectives at Sea</div>
    <h1 class="editorial-title editorial-title-lg" style="margin-bottom: 16px;">
      THE JOURNAL.
    </h1>
    <p class="editorial-subhead">
      Perspectives on nautical architecture, Dubai cruising routes, and superyacht hospitality curated by Oneness captains and directors.
    </p>
  </div>
</section>

<!-- JOURNAL GRID -->
<section class="section section-spacious" style="background-color: var(--bg-void);">
  <div class="container">
    <div class="journal-grid" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 40px;">
      <% blogs.forEach((blog, index) => { %>
        <article class="yacht-showcase-item" style="background-color: var(--bg-surface); border: 1px solid var(--border-subtle);">
          <div class="yacht-item-media">
            <img src="<%= blog.image %>" alt="<%= blog.title %>" loading="lazy">
            <div class="yacht-item-gradient"></div>
            <span style="position: absolute; top: 16px; left: 16px; font-size: 0.68rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--accent-champagne); background: rgba(2,5,11,0.7); padding: 4px 10px; border: 1px solid var(--border-hairline);">
              <%= blog.category %>
            </span>
          </div>

          <div class="yacht-item-body">
            <div style="font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-tertiary); margin-bottom: 10px;">
              <%= blog.date %> &middot; <%= blog.readTime %>
            </div>
            <h2 class="yacht-item-title" style="font-size: 1.3rem; margin-bottom: 12px; line-height: 1.3;">
              <%= blog.title %>
            </h2>
            <p style="font-size: 0.9rem; line-height: 1.7; color: var(--text-secondary); font-weight: 300; margin-bottom: 24px;">
              <%= blog.excerpt %>
            </p>

            <div style="margin-top: auto; padding-top: 16px; border-top: 1px solid var(--border-subtle);">
              <a href="https://wa.me/971585441134?text=Hello%20Oneness%20Yachts,%20I%20read%20your%20journal%20article%20'<%= encodeURIComponent(blog.title) %>'." target="_blank" class="btn-text-arrow">
                <span>Inquire Topic</span>
                <span class="arrow">&rarr;</span>
              </a>
            </div>
          </div>
        </article>
      <% }); %>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
