<%- include('partials/header', { title: 'Bespoke Maritime Journeys | Oneness Luxury Yachts Dubai', activeNav: 'packages' }) %>

<!-- PACKAGES HERO -->
<section class="fleet-hero-header">
  <div class="container">
    <div class="eyebrow">Signature Journeys &middot; Dubai</div>
    <h1 class="editorial-title editorial-title-lg" style="margin-bottom: 16px;">
      EXPERIENCES.
    </h1>
    <p class="editorial-subhead">
      Curated yacht experiences across Dubai, designed around your time, your guests and your occasion.
    </p>
  </div>
</section>

<!-- PACKAGES EDITORIAL SHOWCASE -->
<section class="section section-spacious" style="background-color: var(--bg-void);">
  <div class="container">
    <div style="display: flex; flex-direction: column; gap: 80px;">
      <% packages.forEach((pkg, index) => { %>
        <article style="display: grid; grid-template-columns: <%= index % 2 === 0 ? '1.2fr 1fr' : '1fr 1.2fr' %>; gap: 60px; align-items: center; border-bottom: 1px solid var(--border-subtle); padding-bottom: 80px;">
          <!-- Media Column -->
          <div style="order: <%= index % 2 === 0 ? 1 : 2 %>; position: relative; height: 460px; overflow: hidden; border: 1px solid var(--border-hairline);">
            <img src="<%= pkg.image %>" alt="<%= pkg.title %>" style="width: 100%; height: 100%; object-fit: cover;" loading="lazy">
            <div style="position: absolute; inset: 0; background: linear-gradient(180deg, transparent 60%, rgba(2,5,11,0.7) 100%);"></div>
          </div>

          <!-- Content Column -->
          <div style="order: <%= index % 2 === 0 ? 2 : 1 %>;">
            <div class="eyebrow" style="margin-bottom: 12px;">Curated Itinerary 0<%= index + 1 %></div>
            <h2 class="editorial-title" style="font-size: 2.2rem; margin-bottom: 20px;">
              <%= pkg.title %>
            </h2>
            <p style="font-size: 1.05rem; line-height: 1.8; color: var(--text-secondary); font-weight: 300; margin-bottom: 36px;">
              <%= pkg.description %>
            </p>

            <div style="display: flex; align-items: center; gap: 20px; flex-wrap: wrap;">
              <a href="/contact?package=<%= encodeURIComponent(pkg.title) %>" class="btn-primary">
                Inquire Journey &rarr;
              </a>
              <a href="https://wa.me/971585441134?text=Hello%20Oneness%20Yachts,%20I%20would%20like%20to%20reserve%20the%20<%= encodeURIComponent(pkg.title) %>%20Experience." target="_blank" class="btn-secondary">
                <i class="fab fa-whatsapp" style="margin-right: 6px;"></i> WhatsApp
              </a>
            </div>
          </div>
        </article>
      <% }); %>
    </div>
  </div>
</section>

<!-- BESPOKE EVENT CURATION STATEMENT -->
<section class="section section-spacious" style="background: radial-gradient(circle at 50% 50%, #0d1e35 0%, var(--bg-void) 70%); border-top: 1px solid var(--border-subtle); text-align: center;">
  <div class="container container-narrow">
    <div class="eyebrow" style="justify-content: center;">Bespoke Events</div>
    <h2 class="editorial-title" style="margin-bottom: 24px;">Custom Event Orchestration</h2>
    <p class="editorial-subhead" style="margin: 0 auto 40px;">
      Our senior event curators orchestrate red carpet arrivals, world-renowned DJs, custom floral styling, and drone documentation for weddings, corporate summits, and milestones.
    </p>
    <a href="/contact" class="btn-primary">
      Consult Our Event Planner &rarr;
    </a>
  </div>
</section>

<%- include('partials/footer') %>
